@inherits LayoutComponentBase
@implements IAsyncDisposable

<W1Loading />
<W1Toast />
<!-- Navbar -->
<AuthorizeView>
    <Authorized>
        <div class="sticky-top">
            <header class="navbar navbar-expand-md sticky-top d-print-none">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
                        <a href="/" class="d-flex align-items-center text-decoration-none">
                            <img src="../assets/logo.png" width="110" height="32" style="height: 1.5rem" alt="" class="navbar-brand-image">
                        </a>
                    </h1>
                    <div class="navbar-nav flex-row order-md-last">
                        <div class="nav-item d-none d-md-flex me-3">
                            <div class="btn-list" style="width: 350px">

                            </div>
                        </div>
                        <div class="d-none d-md-flex">
                             <a class="nav-link px-0" title="Nhân thông báo">
                                <DxCheckBox CssClass="w-100 w1FontSize"
                                            SizeMode="@SizeMode.Medium"
                                            Checked="@IsReceiveNotification"
                                            CheckType="@CheckType.Switch"
                                            LabelPosition="@LabelPosition.Right">
                                </DxCheckBox>
                             </a>
                            
                            @* <a class="nav-link px-0" title="Menu nhanh" data-bs-toggle="offcanvas" href="#offcanvasEnd" role="button" aria-controls="offcanvasEnd"
                               data-bs-placement="bottom">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-th-large">
                                    <rect x="3" y="3" width="7" height="7" />
                                    <rect x="14" y="3" width="7" height="7" />
                                    <rect x="3" y="14" width="7" height="7" />
                                    <rect x="14" y="14" width="7" height="7" />
                                </svg>

                            </a> *@
                            <div class="nav-item dropdown d-none d-md-flex me-1">
                                <a href="#" class="nav-link px-0" data-bs-toggle="dropdown" tabindex="-1" aria-label="Show notifications">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-palette">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25" />
                                        <path d="M8.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                        <path d="M12.5 7.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                        <path d="M16.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                    </svg>
                                </a>
                                <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-end dropdown-menu-card">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="row" style="width:230px">
                                                <div class="col-3">
                                                    <div style="background-color: #189cab" class="avatar text-purple-fg" data-demo-color="">
                                                        PK
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div style="background-color: #0487D9" class="avatar text-purple-fg" data-demo-color="">
                                                        PU
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div style="background-color: #fe7109" class="avatar text-purple-fg" data-demo-color="">
                                                        OF
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div style="background-color: #415a80" class="avatar text-purple-fg" data-demo-color="">
                                                        LO
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="nav-item dropdown d-none d-md-flex me-1">
                                <a href="#" class="nav-link px-0" data-bs-toggle="dropdown" tabindex="-1" aria-label="Show notifications">
                                    <!-- Download SVG icon from http://tabler-icons.io/i/bell -->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" /><path d="M9 17v1a3 3 0 0 0 6 0v-1" /></svg>
                                    <span class="badge bg-red">@TotalNotifiCations</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-end dropdown-menu-card">
                                    <div class="card" style="max-width: 500px">
                                        <div class="card-header p-2">
                                            <h3 class="card-title" style="font-size: 13px">Danh sách thông báo</h3>
                                        </div>
                                        <div class="list-group list-group-flush list-group-hoverable">
                                            @foreach (var oItem in ListNotification)
                                            {
                                                <div class="list-group-item py-2" title="@oItem.message">
                                                    <div class="row align-items-center">
                                                        <div class="col-auto"><span class="status-dot status-dot-animated bg-red d-block"></span></div>
                                                        <div class="col text-truncate">
                                                            <a class="text-body d-block">@oItem.objTypeName</a>
                                                            <div class="d-block text-muted text-truncate mt-n1">
                                                                @oItem.message
                                                            </div>
                                                        </div>
                                                        <div class="col-auto">
                                                            <a class="list-group-item-actions">
                                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z" /></svg>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-footer p-2 text-center">
                                            <a href="/danh-sach-thong-bao" style="font-size: 13px">Xem tất cả</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                                <img src="../assets/user.png" width="110" height="32" alt="HSystem" class="navbar-brand-image">
                                <div class="d-none d-xl-block ps-2">
                                    <div style="font-size: 12px;">@FullName</div>
                                    <div class="mt-1 text-muted" style="font-size: 11px;">@UserCode</div>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <a href="/thay-doi-mat-khau" class="dropdown-item">Thay đổi mật khẩu</a>
                                <a href="/thong-tin-nhan-vien" class="dropdown-item">Thông tin nhân viên</a>
                                <a href="/cai-dat-thong-tin" class="dropdown-item">Cài đặt</a>
                                <a href="/dang-xuat" class="dropdown-item">Đăng xuất</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <header class="navbar-expand-md">
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <div class="navbar">
                        <div class="container-fluid">
                            <ul class="navbar-nav">
                                @foreach (var item in ListMenus)
                                {
                                    @if (item.level == 0)
                                    {
                                        var lstMenuLevel2 = ListMenus.Where(m => m.parentID == item.menuID && m.level == 1).ToList();
                                        if (lstMenuLevel2.Any())
                                        {
                                            <li class="nav-item dropdown">
                                                <a class="nav-link dropdown-toggle" href="#@item.menuID" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                    @if (!string.IsNullOrEmpty(item.icon))
                                                    {
                                                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                            @((MarkupString)$"{item.icon}")
                                                        </span>
                                                    }
                                                    <span class="nav-link-title">
                                                        @item.menuName
                                                    </span>
                                                </a>
                                                <div class="dropdown-menu">
                                                    @foreach (var item1 in lstMenuLevel2)
                                                    {
                                                        var lstLevel3 = ListMenus.Where(m => m.parentID == item1.menuID && m.level == 2).ToList();
                                                        if (lstLevel3.Any())
                                                        {
                                                            <div class="dropdown-menu-columns">
                                                                <div class="dropdown-menu-column">
                                                                    <div class="dropend">
                                                                        <a class="dropdown-item dropdown-toggle" href="#@item1.menuID" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                                                            @item1.menuName
                                                                        </a>
                                                                        <div class="dropdown-menu">
                                                                            @foreach (var item2 in lstLevel3)
                                                                            {
                                                                                <a href="@item2.link" class="dropdown-item" @onclick="@CloseMenuHandler">
                                                                                    @item2.menuName
                                                                                </a>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <a class="dropdown-item" href="@item1.link" @onclick="@CloseMenuHandler">
                                                                @item1.menuName
                                                            </a>
                                                        }

                                                    }
                                                </div>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" href="@item.link">
                                                    @if (!string.IsNullOrEmpty(item.icon))
                                                    {
                                                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                            @((MarkupString)$"{item.icon}")
                                                        </span>
                                                    }
                                                    <span class="nav-link-title">
                                                        @item.menuName
                                                    </span>
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </header>
        </div>
    
        <div class="page-wrapper w1FontSize" style="margin: 4px 2px 2px 2px;">
            <W1Breadcrumb Breadcrumbs="@ListBreadcrumbs" />
            <CascadingValue Value="@BreadcrumbsHandler">
                @Body
            </CascadingValue>
        </div>
    </Authorized>
    <NotAuthorized>
        <HNOne.Web.Components.Pages.Authentication.RedirectToLoginPage />
    </NotAuthorized>
</AuthorizeView>
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
