                                }
                            </div>
                        </div>
                    </div>
                </div>
                @if (SummaryReport.totalEmployeesOnMaternityLeaveSoon > 0)
                {
                    <div class="table-responsive" style="max-height: 400px; overflow-x: hidden; overflow-y: auto">
                        <table class="table table-selectable card-table table-vcenter">
                            <tbody>
                                @foreach (var item in ListEmployeesOnMaternityLeaveSoon!)
                                {
                                    <tr>
                                        <td class="w-1 pe-0">
                                            <span class="avatar avatar-sm" style="background-image: url(@item.imageViewUrl)"> </span>
                                        </td>
                                        <td class="w-100">
                                            <a href="@item.link" class="a">@item.code</a>
                                            <div>@item.name</div>
                                        </td>
                                        <td class="text-nowrap text-secondary">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                                                <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"></path>
                                                <path d="M16 3v4"></path>
                                                <path d="M8 3v4"></path>
                                                <path d="M4 11h16"></path>
                                                <path d="M11 15h1"></path>
                                                <path d="M12 15v3"></path>
                                            </svg>
                                            @item.probationEndDate?.ToString(GlobalContants.FORMAT_DATE)
                                        </td>
                                        <td class="text-nowrap">
                                            <a href="#" class="text-secondary">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-time">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4" />
                                                    <path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                                    <path d="M15 3v4" />
                                                    <path d="M7 3v4" />
                                                    <path d="M3 11h16" />
                                                    <path d="M18 16.496v1.504l1 1" />
                                                </svg>
                                                Còn @item.totalNumOfDay ngày
                                            </a>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <div class="text-center">
                            <img src="/assets/same_device.a2cc1c05.png" alt="" height="107" width="119">
                            <div class="mt-2 mb-3 text-secondary" style="font-size: 14px">Không có nhân viên nghỉ thai sản sắp đến hạn</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-sm-12 col-lg-6">
            <div class="card rounded-3">
                <div class="card-header d-flex align-items-center">
                    <div class="d-flex">
                        <div class="subheader card-title">Sinh nhật sắp đến hạn</div>
                        @if (SummaryReport.totalBirthdays > 0)
                        {
                            <div class="h1 mb-0 ms-2" style="line-height: 0.3">@SummaryReport.totalBirthdays.ToString(GlobalContants.FORMAT_CURRENCY)</div>
                        }
                    </div>
                    <div class="ms-auto lh-1">
                        <div class="dropdown">
                            <a class="dropdown-toggle text-secondary" id="revenue-dropdown" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Select time range for revenue">@($"{SummaryReport.dayBirthdays} ngày")</a>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="revenue-dropdown" style="">
                                @foreach(var item in ListCboFilterDays)
                                {
                                    <a class="dropdown-item @(item.code == SummaryReport.dayBirthdays ? "active" : "")" @onclick="@(() => ComboboxValueChangedHandler(item.code, controlID: ProcessConstants.GET_REPORT_SUMMARY_BIRTHDAY))">@item.name</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                @if (SummaryReport.totalBirthdays > 0)
                {
                    <div class="table-responsive" style="max-height: 400px; overflow-x: hidden; overflow-y: auto">
                        <table class="table table-selectable card-table table-vcenter">
                            <tbody>
                                @foreach (var item in ListBirthdays!)
                                {
                                    <tr>
                                        <td class="w-1 pe-0">
                                            <span class="avatar avatar-sm" style="background-image: url(@item.imageViewUrl)"> </span>
                                        </td>
                                        <td class="w-100">
                                            <a href="@item.link" class="a">@item.code</a>
                                            <div>@item.name</div>
                                        </td>
                                        <td class="text-nowrap text-secondary">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                                                <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"></path>
                                                <path d="M16 3v4"></path>
                                                <path d="M8 3v4"></path>
                                                <path d="M4 11h16"></path>
                                                <path d="M11 15h1"></path>
                                                <path d="M12 15v3"></path>
                                            </svg>
                                            @item.dateOfBirth?.ToString(GlobalContants.FORMAT_DATE)
                                        </td>
                                        <td class="text-nowrap">
                                            <a href="#" class="text-secondary">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-time">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4" />
                                                    <path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                                    <path d="M15 3v4" />
                                                    <path d="M7 3v4" />
                                                    <path d="M3 11h16" />
                                                    <path d="M18 16.496v1.504l1 1" />
                                                </svg>
                                                Còn @item.totalNumOfDay ngày
                                            </a>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <div class="text-center">
                            <img src="/assets/same_device.a2cc1c05.png" alt="" height="107" width="119">
                            <div class="mt-2 mb-3 text-secondary" style="font-size: 14px">Không có nhân viên có sinh nhật sắp đến hạn</div>
                        </div>
                    </div>
                }
                
            </div>
        </div>

        <div class="col-sm-12 col-lg-6">
            <div class="card rounded-3">
                <div class="card-header d-flex align-items-center">
                    <div class="d-flex">
                        <div class="subheader card-title">Kỷ niệm ngày vào làm</div>
                        @if (SummaryReport.totalUpcomingWorkAnniversaries > 0)
                        {
                            <div class="h1 mb-0 ms-2" style="line-height: 0.3">@SummaryReport.totalUpcomingWorkAnniversaries.ToString(GlobalContants.FORMAT_CURRENCY)</div>
                        }
                    </div>
                    <div class="ms-auto lh-1">
                        <div class="dropdown">
                            <a class="dropdown-toggle text-secondary" id="revenue-dropdown" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Select time range for revenue">@($"{SummaryReport.dayUpcomingWorkAnniversaries} ngày")</a>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="revenue-dropdown" style="">
                                @foreach(var item in ListCboFilterDays)
                                {
                                    <a class="dropdown-item @(item.code == SummaryReport.dayUpcomingWorkAnniversaries ? "active" : "")" @onclick="@(() => ComboboxValueChangedHandler(item.code, controlID: ProcessConstants.GET_REPORT_SUMMARY_UPCOMING_WORK_ANNIVERSARIES))">@item.name</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                @if (SummaryReport.totalUpcomingWorkAnniversaries > 0)
                {
                    <div class="table-responsive" style="max-height: 400px; overflow-x: hidden; overflow-y: auto">
                        <table class="table table-selectable card-table table-vcenter">
                            <tbody>
                                @foreach (var item in ListUpcomingWorkAnniversaries!)
                                {
                                    <tr>
                                        <td class="w-1 pe-0">
                                            <span class="avatar avatar-sm" style="background-image: url(@item.imageViewUrl)"> </span>
                                        </td>
                                        <td class="w-100">
                                            <a href="@item.link" class="a">@item.code</a>
                                            <div>@item.name</div>
                                        </td>
                                        <td class="text-nowrap text-secondary">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                                                <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"></path>
                                                <path d="M16 3v4"></path>
                                                <path d="M8 3v4"></path>
                                                <path d="M4 11h16"></path>
                                                <path d="M11 15h1"></path>
                                                <path d="M12 15v3"></path>
                                            </svg>
                                            @item.probationStartDate?.ToString(GlobalContants.FORMAT_DATE)
                                        </td>
                                        <td class="text-nowrap">
                                            <a class="text-secondary">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-time">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4" />
                                                    <path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                                    <path d="M15 3v4" />
                                                    <path d="M7 3v4" />
                                                    <path d="M3 11h16" />
                                                    <path d="M18 16.496v1.504l1 1" />
                                                </svg>
                                                Còn @item.totalNumOfDay ngày
                                            </a>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <div class="text-center">
                            <img src="/assets/same_device.a2cc1c05.png" alt="" height="107" width="119">
                            <div class="mt-2 mb-3 text-secondary" style="font-size: 14px">Không có nhân viên sắp kỷ niệm ngày vào làm</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-bottom h-auto" tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
    <div class="offcanvas-header px-3 py-3">
        <h3 class="offcanvas-title" id="offcanvasBottomLabel">@PopupTypeName</h3>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body py-2 px-2" style="max-height: 400px;min-height: 200px; overflow-x: hidden; overflow-y: auto">
        @if (ListEmployeeByOverview != null && ListEmployeeByOverview.Any())
        {
            <div class="table-responsive">
                <table class="table table-selectable card-table table-vcenter">
                    <tbody>
                        @foreach (var item in ListEmployeeByOverview!)
                        {
                            <tr>
                                <td class="w-1 pe-0">
                                    <span class="avatar avatar-sm" style="background-image: url(@item.imageViewUrl)"> </span>
                                </td>
                                <td class="w-50">
                                    <a href="@item.link" class="a">@item.code</a>
                                    <div>@item.name</div>
                                </td>
                                <td class="text-nowrap">
                                    <div>@item.remark</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (ListContracts != null && ListContracts.Any())
        {
            <div class="table-responsive">
                <table class="table table-selectable card-table table-vcenter">
                    <tbody>
                        @foreach (var item in ListContracts!)
                        {
                            <tr>
                                <td class="w-33">
                                    <a href="@item.linkContract" class="a">@item.contractCode</a>
                                    <div>@item.contractTypeName</div>
                                </td>
                                <td class="w-33">
                                    <a>@item.employeeCode</a>
                                    <div>@item.employeeName</div>
                                </td>
                                <td class="text-nowrap text-secondary">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                                        <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"></path>
                                        <path d="M16 3v4"></path>
                                        <path d="M8 3v4"></path>
                                        <path d="M4 11h16"></path>
                                        <path d="M11 15h1"></path>
                                        <path d="M12 15v3"></path>
                                    </svg>
                                    @item.endDate?.ToString(GlobalContants.FORMAT_DATE)
                                </td>
                                @if (item.contractNumber > 0)
                                {
                                    <td class="text-nowrap">
                                        <a class="text-secondary">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-time">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4" />
                                                <path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                                <path d="M15 3v4" />
                                                <path d="M7 3v4" />
                                                <path d="M3 11h16" />
                                                <path d="M18 16.496v1.504l1 1" />
                                            </svg>
                                            Còn @item.contractNumber ngày
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <W1NoData />
        }
    </div>
</div>