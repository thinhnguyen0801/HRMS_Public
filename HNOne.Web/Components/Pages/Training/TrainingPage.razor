@page "/dao-tao"
@inherits Controllers.TrainingController
<PageTitle>Đào tạo</PageTitle>

<div class="h-content-filter">
    @if (!IsReadonlyControl)
    {
        <div class="card p-1">
            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                <Items>

                    <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler"
                                   Visible="@((pActionType == nameof(EnumType.Add) && IsAllowPost) || (pActionType != nameof(EnumType.Add) && IsAllowPut))" />

                    <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(()=> SubmitForApprovalHandler())"
                                   Visible="@(TrainDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)"/>

                    <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right"
                                   Visible="@(pActionType != nameof(EnumType.Add) && TrainDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)"/>

                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshDataHandler" />
                </Items>
            </DxToolbar>
        </div>
    }
    else
    {
        @if(IsAllowPutEvaluete)
        {
            <div class="card p-1">
                <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                    <Items>
                        <DxToolbarItem Text="Lưu đánh giá" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                       Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataEvalueteHandler" />
                    </Items>
                </DxToolbar>
            </div>
        }
    }

    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin chung</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@TrainDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@TrainDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Khóa đào tạo" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@TrainDocument.trainingCourseName" CssClass="w1FontSize" Id="trainingCourseName" ReadOnly="@IsReadonlyControl"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Hình thức" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboTrainFormat"
                                                            @bind-Value="@TrainDocument.traningFormatCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            Id="traningFormatCode"
                                                            ReadOnly="@IsReadonlyControl"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@TrainDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeSignatureId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@TrainDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(TrainDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@TrainDocument.dateOfSigning"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Y/c đào tạo" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="d-flex">
                                                    <div>
                                                        <DxRadio SizeMode="@SizeMode.Small" GroupName="general-radio-group" Value="@("Nội bộ")" @bind-GroupValue="@TrainDocument.typeOfTraning" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl">Nội bộ</DxRadio>
                                                    </div>
                                                    <div class="px-2">
                                                        <DxRadio SizeMode="@SizeMode.Small" GroupName="general-radio-group" Value="@("Bên ngoài")" @bind-GroupValue="@TrainDocument.typeOfTraning" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl">Bên ngoài</DxRadio>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Từ ngày/đến ngày" Id="ngayBatDau" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit @bind-Date="@TrainDocument.fromDate"
                                                                    CssClass="w1FontSize" Id="startDate" ReadOnly="@IsReadonlyControl"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit @bind-Date="@TrainDocument.toDate"
                                                                    CssClass="w1FontSize" Id="endDate" ReadOnly="@IsReadonlyControl"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Địa điểm" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@TrainDocument.address" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nội dung đào tạo" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@TrainDocument.content" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtghiChu" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Mục tiêu đào tạo" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@TrainDocument.objectives" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtghiChu" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Chi tiết đào tạo" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@TrainDocument.noteForAll" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtghiChu" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ghi chú" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@TrainDocument.remark" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtghiChu" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Danh sách nhân viên" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListOfTrainings" @ref="GridOfTrainings"
                                        ShowFilterRow="false"
                                        PageSize="500"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldNames="@(new [] {nameof(Training1Model.employeeId),nameof(Training1Model.id)})"
                                        ValidationEnabled="true"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="@GridEditSavingHandler"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Multiple"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_ADD" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Thêm nhân viên"
                                                               Visible="@(!IsReadonlyControl)"
                                                               Click="@(async () => await OpenPopupHandler(nameof(ListEmpSelected), nameof(ListEmpSelected)))" />
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_DELETE" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Xóa nhân viên"
                                                               Visible="@(!IsReadonlyControl)"
                                                               Click="@DeleteDataHandler" />
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridSelectionColumn Width="35px" />
                                        <DxGridDataColumn FieldName="@nameof(Training1Model.employeeCode)" Caption="Mã nhân viên" MinWidth="120" Width="120px" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(Training1Model.employeeName)" Caption="Tên nhân viên" MinWidth="160" Width="160px" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(Training1Model.isAbsent)" Caption="Vắng?" MinWidth="95" Width="95px" DataRowEditorVisible="@(IsReadonlyControl)" />
                                        <DxGridDataColumn FieldName="@nameof(Training1Model.noteForAll)" Caption="Đánh giá" MinWidth="170" DataRowEditorVisible="@(IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Đánh giá <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(Training1Model.remark)" Caption="Ghi chú" MinWidth="170" DataRowEditorVisible="@(IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Ghi chú <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                    </Columns>
                                </DxGrid>
                            </div>
                            break;
                        case 1:
                            <div style="height: 350px; min-height: 350px; line-height: 20px" class="w1FontSize px-2 py-1 text-truncate">
                                @((MarkupString)$"{VoucherHistory}")
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="70%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    SelectionMode="@DxGridEmployeeSelectionMode"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" SelectedDataItemsChanged="@EventCallbackEmpListChangedHandler" />
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />

