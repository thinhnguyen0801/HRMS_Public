@page "/ho-so-nhan-vien"
@inherits Controllers.EmployeeController
<PageTitle>Hồ sơ nhân viên</PageTitle>

<div class="h-content-filter">
    <div class="w1FontSize sticky-top" style="z-index: 1010">
        <div class="border-bottom-0">
            <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize h1-tab-scroll">
                <DxTabPage Text="Thông tin chung" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-1"))"></DxTabPage>
                <DxTabPage Text="CMND/CCCD/Hộ chiếu" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-2"))"></DxTabPage>
                <DxTabPage Text="Thông tin liên hệ" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-3"))"></DxTabPage>
                <DxTabPage Text="Hộ khẩu thường trú" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-4"))"></DxTabPage>
                <DxTabPage Text="Chỗ ở hiện nay" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-5"))"></DxTabPage>
                <DxTabPage Text="Liên hệ khẩn cấp" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-6"))"></DxTabPage>
                <DxTabPage Text="Thông tin công việc" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-8"))"></DxTabPage>
                @if(pActionType == nameof(EnumType.Update))
                {
                    <DxTabPage Text="Trình độ/Bằng cấp" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-14"))"></DxTabPage>
                    <DxTabPage Text="Quan hệ gia đình" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-7"))"></DxTabPage>
                    <DxTabPage Text="Lịch sử công tác" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-9"))"></DxTabPage>
                    <DxTabPage Text="Thông tin bảo hiểm" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-10"))"></DxTabPage>
                    <DxTabPage Text="Danh sách hợp đồng" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-11"))"></DxTabPage>
                    <DxTabPage Text="Danh sách quyết định" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-12"))"></DxTabPage>
                    <DxTabPage Text="Lịch sử lương" CssClass="w1FontSize" Click="@(() => ScrollToSection("section-accordion-13"))"></DxTabPage>                    
                }
            </DxTabs>
        </div>
    </div>
    <div class="card p-1 mt-1">
        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
            <Items>
                <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" />

                <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@(() => SaveDataHandler())" />

                <DxToolbarItem Text="Lưu & tạo tài khoản" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@(() => SaveDataHandler(isCreateAccount: true))" />

                <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" />
            </Items>
        </DxToolbar>
    </div>

    @* Thông tin chung  *@
    <div class="card card-lg mt-1" style="padding: 5px" id="section-accordion-1">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-1">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin chung</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-1" class="accordion-collapse collapse show" data-bs-parent="#accordion-1">
                            <div class="accordion-body p-2">
                                <div class="grid gap-3 row-gap-2">
                                    <div class="g-col-lg-2 g-col-md-3 g-col-sm-12 g-col-12">
                                        <div class="g-col-lg-2 g-col-md-3 g-col-sm-12 g-col-12">
                                            <label for="file-upload-1">
                                                <img src="@EmployeeUpdate.imageViewUrl" class="avatar avatar-xl mb-3 rounded" style="width: 9rem; height: 9rem" />
                                            </label>
                                            <div>
                                                <W1Label Value="Chọn hình ảnh (nếu có):" />
                                                <InputFile id="ref-upload" accept="image/*" OnChange="@OnLoadFileHandler" />
                                                <div class="text-secondary">
                                                    *Lưu ý: dung lượng file không quá 2MB và ảnh JPG, PNG
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="g-col-lg-10 g-col-md-9 g-col-sm-12 g-col-12">
                                        <div class="row row-gap-2">
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Mã nhân viên" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <div class="grid gap-1 row-gap-2">
                                                            <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                                <DxTextBox @bind-Text="@EmployeeUpdate.code" ReadOnly="true" CssClass="w1FontSize"></DxTextBox>
                                                            </div>
                                                            <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                                <DxComboBox Data="@ListCboEmployeeType"
                                                                            @bind-Value="@EmployeeUpdate.employeeType"
                                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                                            NullText="Loại nhân viên"
                                                                            ReadOnly="@(pActionType == nameof(EnumType.Update))"
                                                                            CssClass="w1FontSize" Id="employeeType">
                                                                </DxComboBox>
                                                            </div>
                                                        </div>
                                                        
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Họ tên" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.name" CssClass="w1FontSize" Id="@nameof(EmployeeUpdate.name)"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Trạng thái" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxComboBox Data="@ListCboStatus"
                                                                    @bind-Value="@EmployeeUpdate.statusId"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.name)"
                                                                    ValueFieldName="@nameof(ComboboxModel.code)" CssClass="w1FontSize">
                                                        </DxComboBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Giới tính" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <div class="d-flex">
                                                            <div>
                                                                <DxRadio SizeMode="@SizeMode.Small" GroupName="general-radio-group" Value="@("Nam")" @bind-GroupValue="@EmployeeUpdate.gender" CssClass="w1FontSize">Nam</DxRadio>
                                                            </div>
                                                            <div class="px-2">
                                                                <DxRadio SizeMode="@SizeMode.Small" GroupName="general-radio-group" Value="@("Nữ")" @bind-GroupValue="@EmployeeUpdate.gender" CssClass="w1FontSize">Nữ</DxRadio>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Ngày sinh" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxDateEdit @bind-Date="@EmployeeUpdate.dateOfBirth" DisplayFormat="@GlobalContants.FORMAT_DATE" Id="@nameof(EmployeeUpdate.dateOfBirth)"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize" />
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Phòng ban" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxComboBox Data="@ListCboDepartment"
                                                                    @bind-Value="@EmployeeUpdate.departmentId"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.name)"
                                                                    Id="@nameof(EmployeeUpdate.departmentId)"
                                                                    ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                                        </DxComboBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Chức vụ" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxComboBox Data="@ListCboPosition"
                                                                    @bind-Value="@EmployeeUpdate.positionId"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.name)"
                                                                    ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                                        </DxComboBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Chức danh" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxComboBox Data="@ListCboTitle"
                                                                    @bind-Value="@EmployeeUpdate.titleId"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.name)"
                                                                    ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                                        </DxComboBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Quản lý trực tiếp" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <div class="grid gap-1 row-gap-2">
                                                            <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                                <DxTextBox @bind-Text="@EmployeeUpdate.managerCode" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                                                            </div>
                                                            <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                                <DxTextBox @bind-Text="@EmployeeUpdate.managerName" CssClass="w1FontSize" ReadOnly="true">
                                                                    <Buttons>
                                                                        <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                        Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(EmployeeUpdate.managerCode)))" />
                                                                    </Buttons>
                                                                </DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Quản lý gián tiếp" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <div class="grid gap-1 row-gap-2">
                                                            <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                                <DxTextBox @bind-Text="@EmployeeUpdate.managerCode2" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                                                            </div>
                                                            <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                                <DxTextBox @bind-Text="@EmployeeUpdate.managerName2" CssClass="w1FontSize" ReadOnly="true">
                                                                    <Buttons>
                                                                        <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                        Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(EmployeeUpdate.managerCode2)))" />
                                                                    </Buttons>
                                                                </DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Dân tộc" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.ethnicity" CssClass="w1FontSize"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Tôn giáo" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.religion" CssClass="w1FontSize"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Quốc tịch" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.nationality" CssClass="w1FontSize"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Tình trạng hôn nhân" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxComboBox Data="@ListCboMaritalStatus"
                                                                    @bind-Value="@EmployeeUpdate.maritalStatus"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.name)"
                                                                    ValueFieldName="@nameof(ComboboxModel.code)" CssClass="w1FontSize">
                                                        </DxComboBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="MST cá nhân" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.taxNumber" CssClass="w1FontSize"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Thông tin CMMD/CCCD/Passport  *@
    <div class="card card-lg mt-1" style="padding: 5px" id="section-accordion-2">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-2">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-2" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">CMMD/Thẻ căn cước/Hộ chiếu</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-2" class="accordion-collapse collapse show" data-bs-parent="#accordion-2">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="row row-gap-2">
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="CCCD/CMND" Styles="width: 120px" IsRequired="true" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.cIC" CssClass="w1FontSize" Id="@nameof(EmployeeUpdate.cIC)"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Ngày cấp" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxDateEdit @bind-Date="@EmployeeUpdate.issuanceDateCIC" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize"
                                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Nơi cấp" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.placeOfIssuanceCIC" CssClass="w1FontSize"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Ngày hết hạn" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxDateEdit @bind-Date="@EmployeeUpdate.expiryDateCIC" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize"
                                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="row row-gap-2">
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Hộ chiếu" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.passportNumber" CssClass="w1FontSize" Id="@nameof(EmployeeUpdate.cIC)"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Ngày cấp" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxDateEdit @bind-Date="@EmployeeUpdate.issueDatePassport" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize"
                                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Nơi cấp" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxTextBox @bind-Text="@EmployeeUpdate.placeOfIssuePassport" CssClass="w1FontSize"></DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Ngày hết hạn" Styles="width: 120px" />
                                                    <div style="width: calc(100% - 120px)">
                                                        <DxDateEdit @bind-Date="@EmployeeUpdate.expiryDatePassport" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize"
                                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Thông tin liên hệ  *@
    <div class="card card-lg mt-1" style="padding: 5px" id="section-accordion-3">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-3">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-3" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin liên hệ</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-3" class="accordion-collapse collapse show" data-bs-parent="#accordion-3">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="ĐT di động" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@EmployeeUpdate.phone1" CssClass="w1FontSize"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="ĐT cơ quan" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@EmployeeUpdate.phone2" CssClass="w1FontSize"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="ĐT nhà riêng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@EmployeeUpdate.phone3" CssClass="w1FontSize"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="ĐT khác" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@EmployeeUpdate.phone4" CssClass="w1FontSize"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Email cá nhân" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@EmployeeUpdate.email1" CssClass="w1FontSize"></DxTextBox>
                                            </div>
                                        </div>
                                    </div>
