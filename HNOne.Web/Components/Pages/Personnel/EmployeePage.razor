                        <div style="width: calc(100% - 110px)">
                            <DxMemo @bind-Text="@FamilyRelationshipUpdate.remark" CssClass="w1FontSize" BindValueMode="@BindValueMode.OnInput" Rows="2" />`
                        </div>
                    </div>
