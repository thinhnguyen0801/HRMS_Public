    @* Quan hệ gia đình  *@
    <div class="card card-lg mt-1" style="padding: 5px" id="section-accordion-7">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-7">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-7" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Quan hệ gia đình</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-7" class="accordion-collapse collapse show" data-bs-parent="#accordion-7">
                            <div class="accordion-body p-0">
                                <div class="row row-gap-2">
                                    <div class="col-md-12 col-sm-12">
                                        <DxGrid Data="ListFamilyRelationship" @ref="GridFamilyRelationship"
                                                ShowFilterRow="false"
                                                PageSize="500"
                                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                PagerPosition="GridPagerPosition.Bottom"
                                                PageSizeSelectorVisible="false"
                                                PageSizeSelectorAllRowsItemVisible="false"
                                                PagerSwitchToInputBoxButtonCount="10"
                                                PagerVisibleNumericButtonCount="10"
                                                TextWrapEnabled="false"
                                                KeyFieldName="@nameof(FamilyRelationshipModel.id)"
                                                ValidationEnabled="true"
                                                AllowSelectRowByClick="true"
                                                FocusedRowEnabled="true"
                                                SelectionMode="GridSelectionMode.Single"
                                                CssClass="h-full">
                                            <ToolbarTemplate>
                                                <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                                    <Items>
                                                        <DxToolbarItem IconCssClass="@IconClassConstants.ICON_ADD" BeginGroup="true" Alignment="@ToolbarItemAlignment.Right"
                                                                       Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupFamily)))" />
                                                        <DxToolbarItem IconCssClass="@IconClassConstants.ICON_REFRESH" BeginGroup="true" Alignment="@ToolbarItemAlignment.Right"
                                                                       Click="@(async () => await RefreshHandler(nameof(IsShowPopupFamily)))" />
                                                    </Items>
                                                </DxToolbar>
                                            </ToolbarTemplate>
                                            <Columns>
                                                <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.name)" Caption="Họ tên" MinWidth="140">
                                                    <CellDisplayTemplate>
                                                        @{
                                                            <a @onclick="@(() => OpenPopupHandler(nameof(IsShowPopupFamily), "", EnumType.Update, (context.DataItem as FamilyRelationshipModel)))">@context.Value</a>
                                                        }
                                                    </CellDisplayTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.relationshipName)" Caption="Mối quan hệ" MinWidth="110" />
                                                <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.phoneNumber)" Caption="Số điện thoại" MinWidth="110" />
                                                <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.dateOfBirth)" Caption="Ngày sinh" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                @* <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.occupation)" Caption="Nghề nghiệp" MinWidth="140" /> *@
                                                <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.contactAddress)" Caption="Địa chỉ" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(FamilyRelationshipModel.remark)" Caption="Ghi chú" MinWidth="170" />
                                            </Columns>
                                        </DxGrid>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
