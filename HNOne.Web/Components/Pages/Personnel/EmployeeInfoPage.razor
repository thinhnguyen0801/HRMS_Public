<W1Popup @bind-IsOpenModal="@IsShowPopupChangePass"
         Width="60%" TextBtnAccept="Cập nhật"
         HeaderText="Thay đổi mật khẩu"
         HandleClickAccept="@ChangePassHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mã nhân viên" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@UserUpdate.employeeCode" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Họ tên" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@UserUpdate.employeeName" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mã tài khoản" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@UserUpdate.userName" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mật khẩu củ" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@UserUpdate.password" CssClass="w1FontSize" Password="true"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mật khẩu mới" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@UserUpdate.passwordNew" CssClass="w1FontSize" Password="true"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Nhập lại mật khẩu mới" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@UserUpdate.rePassword" CssClass="w1FontSize" Password="true"></DxTextBox>
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowPopupContractAppendix"
         Width="60%" IsShowFooter="false"
         HeaderText="Thông tin phụ lục hợp đồng" >
    <div class="row row-gap-2">
        <div class="col-sm-12">
            @if (ListContractAppendix != null && ListContractAppendix.Any())
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-striped">
                        <tbody>
                            @foreach (var item in ListContractAppendix)
                            {
                                <tr class="text-truncate">
                                    <td class="px-0 py-2">
                                        <div class="d-flex ">
                                            <div class="text-secondary" style="width: 150px">
                                                Mã hợp đồng
                                            </div>
                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                <a class="a">@item.contractCode</a>
                                            </div>
                                        </div>
                                        <div class="d-flex ">
                                            <div class="text-secondary" style="width: 150px">
                                                Mã phụ lục
                                            </div>
                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                <a class="a">@item.contractAppendixCode</a>
                                            </div>
                                        </div>
                                        <div class="d-flex mt-2">
                                            <div class="text-secondary" style="width: 150px">
                                                Phụ lục số
                                            </div>
                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                @item.contractNumber
                                            </div>
                                        </div>
                                        <div class="d-flex mt-2">
                                            <div class="text-secondary" style="width: 150px">
                                                Trạng thái
                                            </div>
                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                @(string.IsNullOrEmpty(item.statusName) ? "--" : item.statusName)
                                            </div>
                                        </div>
                                        <div class="d-flex mt-2">
                                            <div class="text-secondary" style="width: 150px">
                                                Ngày ký
                                            </div>
                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                @(item.dateOfSigning?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                            </div>
                                        </div>
                                        <div class="d-flex mt-2">
                                            <div class="text-secondary" style="width: 150px">
                                                Ngày áp dụng
                                            </div>
                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                @(item.effectiveDate?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <W1NoData />
            }

        </div>
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />