@page "/thong-tin-nhan-vien"
@inherits Controllers.EmployeeInfoController

<div class="h-content-filter">
    <div class="card mb-3">
        <div class="row g-0">
            <div class="col-12 col-md-4 col-lg-3 border-end">
                <div class="card-body py-2 px-3">
                    <div class="row row-gap-2">
                        <div class="col-sm-12 text-center">
                            <span class="avatar avatar-2xl avatar-2xl mb-3 mt-2 rounded-circle" style="background-image: url(@EmployeeUpdate.imageViewUrl)"></span>
                            <h3 class="m-0 mb-1">@EmployeeUpdate.code - @EmployeeUpdate.name</h3>
                            <div class="text-secondary mb-1">@EmployeeUpdate.titleName</div>
                        </div>
                    </div>
                </div>
                <div class="card-body py-3 px-3">
                    <div class="row row-gap-2">
                        <div class="col-sm-12">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-transparent avatar avatar-sm">
                                        <i class="fa-solid fa-cake-candles fs-3"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div class="text-secondary text-truncate">
                                        Ngày sinh
                                    </div>
                                    <div class="fw-medium">
                                        @(EmployeeUpdate.dateOfBirth?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-transparent avatar avatar-sm">
                                        <i class="fa-solid fa-venus-mars fs-3"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div class="text-secondary">
                                        Giới tính
                                    </div>
                                    <div class="fw-medium text-truncate">
                                        @(string.IsNullOrEmpty(EmployeeUpdate.gender) ? "--" : EmployeeUpdate.gender)
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-transparent avatar avatar-sm">
                                        <i class="fa-solid fa-heart fs-3"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div class="text-secondary">
                                        Tình trạng hôm nhân
                                    </div>
                                    <div class="fw-medium text-truncate">
                                        @(string.IsNullOrEmpty(EmployeeUpdate.maritalStatusName) ? "--" : EmployeeUpdate.maritalStatusName)
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-transparent avatar avatar-sm">
                                        <i class="fa-solid fa-calendar-days fs-3"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div class="text-secondary text-truncate">
                                        Ca làm việc
                                    </div>
                                    <div class="fw-medium">
                                        @(string.IsNullOrEmpty(EmployeeUpdate.shiftName) ? "--" : EmployeeUpdate.shiftName)
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-transparent avatar avatar-sm">
                                        <i class="fa-solid fa-terminal fs-3"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div class="text-secondary">
                                        Mã số thuế
                                    </div>
                                    <div class="fw-medium text-truncate">
                                        @(string.IsNullOrEmpty(EmployeeUpdate.taxNumber) ? "--" : EmployeeUpdate.taxNumber)
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-transparent avatar avatar-sm">
                                        <i class="fa-solid fa-building-columns fs-3"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div class="text-secondary">
                                        Ngân hàng
                                    </div>
                                    <div class="fw-medium text-truncate">
                                        @EmployeeUpdate.bankName - @EmployeeUpdate.accountNumber
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-8 col-lg-9 d-flex flex-column">
                <div class="card-body p-0">
                    <div class="card-header p-0 border-bottom-0">
                        <DxTabs @bind-ActiveTabIndex="@ActiveTabMainIndex" Id="tabActive" CssClass="w-full w1FontSize">
                            <DxTabPage Text="Thông tin cá nhân" Id="tabPending" CssClass="w1FontSize"></DxTabPage>
                            <DxTabPage Text="Công việc" Id="tabAll" CssClass="w1FontSize"></DxTabPage>
                        </DxTabs>
                    </div>
                    @switch(ActiveTabMainIndex)
                    {
                        case 0:
                            <div class="w-full">
                                @* Thông tin CMMD/CCCD/Passport  *@
                                <div class="card-body py-3 px-3 border-top-0">
                                    <div class="row row-gap-2">
                                        <div class="col-sm-12">
                                            <div class="d-flex justify-content-between">
                                                <h3 class="m-0 mb-1">Thông tin căn cước & hộ chiếu</h3>
                                                <div class="row">
                                                    <DxButton Text="Đổi mật khẩu" IconCssClass="@($"{IconClassConstants.ICON_EDIT}")" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupChangePass)))" />
                                                    <DxButton Text="Chỉnh sửa" IconCssClass="@IconClassConstants.ICON_EDIT" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline" Visible="@(IsAllowPut)"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupUpdateEmployee), popupType: nameof(EmployeeUpdate.cIC), headerText: "Thay đổi thông tin căn cước & hộ chiếu"))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Căn cước công dân
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.cIC) ? "--" : EmployeeUpdate.cIC)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Ngày cấp
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(EmployeeUpdate.issuanceDateCIC?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Nơi cấp
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.placeOfIssuanceCIC) ? "--" : EmployeeUpdate.placeOfIssuanceCIC)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Ngày hết hạn
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(EmployeeUpdate.expiryDateCIC?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Hộ chiếu
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.passportNumber) ? "--" : EmployeeUpdate.passportNumber)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Ngày cấp
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(EmployeeUpdate.issueDatePassport?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Nơi cấp
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.placeOfIssuePassport) ? "--" : EmployeeUpdate.placeOfIssuanceCIC)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Ngày hết hạn
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(EmployeeUpdate.expiryDatePassport?.ToString(GlobalContants.FORMAT_DATE) ?? "--")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Thông tin liên hệ  *@
                                <div class="card-body py-3 px-3">
                                    <div class="row row-gap-2">
                                        <div class="col-sm-12">
                                            <div class="d-flex justify-content-between">
                                                <h3 class="m-0 mb-1">Thông tin liên hệ</h3>
                                                <div>
                                                    <DxButton Text="Chỉnh sửa" IconCssClass="@IconClassConstants.ICON_EDIT" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline" Visible="@(IsAllowPut)"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupUpdateEmployee), popupType: nameof(EmployeeUpdate.phone1), headerText: "Thay đổi thông tin liên hệ"))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Điện thoại di động
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.phone1) ? "--" : EmployeeUpdate.phone1)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Điện thoại cơ quan
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.phone2) ? "--" : EmployeeUpdate.phone2)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Điện thoại nhà riêng
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.phone3) ? "--" : EmployeeUpdate.phone3)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Điện thoại khác
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.phone4) ? "--" : EmployeeUpdate.phone4)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Email cá nhân
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.email1) ? "--" : EmployeeUpdate.email1)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Email cơ quan
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.email2) ? "--" : EmployeeUpdate.email2)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Email khác
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.email3) ? "--" : EmployeeUpdate.email3)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Nguyên quán
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.placeOfOrigin) ? "--" : EmployeeUpdate.placeOfOrigin)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Tỉnh thành
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.provinceName) ? "--" : EmployeeUpdate.provinceName)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Nơi sinh
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.placeOfBirth) ? "--" : EmployeeUpdate.placeOfBirth)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Hộ khẩu thường trú  *@
                                <div class="card-body py-3 px-3">
                                    <div class="row row-gap-2">
                                        <div class="col-sm-12">
                                            <div class="d-flex justify-content-between">
                                                <h3 class="m-0 mb-1">Hộ khẩu thường trú</h3>
                                                <div>
                                                    <DxButton Text="Chỉnh sửa" IconCssClass="@IconClassConstants.ICON_EDIT" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline" Visible="@(IsAllowPut)"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupUpdateEmployee), popupType: nameof(EmployeeUpdate.houseNumber1), headerText: "Thay đổi thông tin hộ khẩu thường trú"))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Số nhà
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.houseNumber1) ? "--" : EmployeeUpdate.houseNumber1)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Địa chỉ
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.placeOfResidence) ? "--" : EmployeeUpdate.placeOfResidence)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Số hộ khẩu
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.householdRegistrationNumber) ? "--" : EmployeeUpdate.householdRegistrationNumber)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Mã số hộ gia đình
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.householdNumber) ? "--" : EmployeeUpdate.householdNumber)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Chỗ ở hiện nay  *@
                                <div class="card-body py-3 px-3">
                                    <div class="row row-gap-2">
                                        <div class="col-sm-12">
                                            <div class="d-flex justify-content-between">
                                                <h3 class="m-0 mb-1">Chỗ ở hiện nay</h3>
                                                <div>
                                                    <DxButton Text="Chỉnh sửa" IconCssClass="@IconClassConstants.ICON_EDIT" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline" Visible="@(IsAllowPut)"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupUpdateEmployee), popupType: nameof(EmployeeUpdate.houseNumber2), headerText: "Thay đổi thông tin chỗ ở hiện nay"))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Số nhà/Đường phố
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.houseNumber2) ? "--" : EmployeeUpdate.houseNumber2)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Địa chỉ
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.temporaryAddress) ? "--" : EmployeeUpdate.temporaryAddress)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Liên hệ khẩn cấp *@
                                <div class="card-body py-3 px-3">
                                    <div class="row row-gap-2">
                                        <div class="col-sm-12">
                                            <div class="d-flex justify-content-between">
                                                <h3 class="m-0 mb-1">Liên hệ khẩn cấp</h3>
                                                <div>
                                                    <DxButton Text="Chỉnh sửa" IconCssClass="@IconClassConstants.ICON_EDIT" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline" Visible="@(IsAllowPut)"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupUpdateEmployee), popupType: nameof(EmployeeUpdate.fullName1), headerText: "Thay đổi thông tin liên hệ khẩn cấp"))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Người liên hệ
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.fullName1) ? "--" : EmployeeUpdate.fullName1)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Quan hệ
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.relationshipName) ? "--" : EmployeeUpdate.relationshipName)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Điện thoại di động
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.phone5) ? "--" : EmployeeUpdate.phone5)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Điện thoại nhà riêng
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.phone6) ? "--" : EmployeeUpdate.phone6)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Email
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.email4) ? "--" : EmployeeUpdate.email4)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="d-flex ">
                                                <div class="text-secondary" style="width: 150px">
                                                    Địa chỉ
                                                </div>
                                                <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                    @(string.IsNullOrEmpty(EmployeeUpdate.contactAddress) ? "--" : EmployeeUpdate.contactAddress)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Quan hệ gia đình *@
                                <div class="card-body py-3 px-3">
                                    <div class="row row-gap-2">
                                        <div class="col-sm-12">
                                            <div class="d-flex justify-content-between">
                                                <h3 class="m-0 mb-1">Quan hệ gia đình</h3>
                                                <div>
                                                    <DxButton Text="Thêm mới" IconCssClass="@IconClassConstants.ICON_ADD" CssClass="w1FontSize"
                                                              RenderStyleMode="@ButtonRenderStyleMode.Outline" Visible="@(IsAllowPut)"
                                                              Click="@(async () => await OpenPopupHandler(nameof(IsShowPopupFamily)))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            @if (ListFamilyRelationship != null && ListFamilyRelationship.Any())
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-vcenter card-table table-striped">
                                                        <tbody>
                                                            @foreach (var item in ListFamilyRelationship)
                                                            {
                                                                <tr class="text-truncate">
                                                                    <td class="px-0 py-2">
                                                                        <div class="d-flex ">
                                                                            <div class="text-secondary" style="width: 150px">
                                                                                @item.relationshipName
                                                                            </div>
                                                                            <div class="fw-medium text-truncate" style="width: calc(100% - 150px)">
                                                                                @if (IsAllowPut)
                                                                                {
                                                                                    <a class="a cursor-pointer" @onclick="@(() => OpenPopupHandler(nameof(IsShowPopupFamily), "", EnumType.Update, item))">@item.name</a>
                                                                                }
