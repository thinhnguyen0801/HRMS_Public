@* Thêm thông quan hệ gia đình *@
<W1Popup @bind-IsOpenModal="@IsShowPopupFamily"
         Width="60%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreatePopup ? "Thêm mới quan hệ gia đình" : $"Cập nhật quan hệ gia đình")"
         HandleClickAccept="@SaveFamilyRelationshipHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mối Quan hệ" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxComboBox Data="@ListCboRelationship"
                                @bind-Value="@FamilyRelationshipUpdate.relationshipId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                ValueFieldName="@nameof(ComboboxModel.code)"
                                CssClass="w1FontSize" Id="txtFamilyRelationshipId">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Họ tên" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@FamilyRelationshipUpdate.name" CssClass="w1FontSize" Id="txtFamilyRelationshipName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Số điện thoại" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@FamilyRelationshipUpdate.phoneNumber" CssClass="w1FontSize"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Ngày sinh" Styles="width: 110px" />
                <div style="width: calc(100% - 120px)">
                    <DxDateEdit @bind-Date="@FamilyRelationshipUpdate.dateOfBirth"
                                CssClass="w1FontSize"
                                Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                DisplayFormat="@GlobalContants.FORMAT_DATE" />
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Địa chỉ" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@FamilyRelationshipUpdate.contactAddress" CssClass="w1FontSize"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Ghi chú" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxMemo @bind-Text="@FamilyRelationshipUpdate.remark" CssClass="w1FontSize" BindValueMode="@BindValueMode.OnInput" Rows="2" />
                </div>
            </div>
        </div>
    </div>
</W1Popup>

