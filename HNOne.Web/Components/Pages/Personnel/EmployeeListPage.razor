@page "/danh-sach-nhan-vien"
@inherits Controllers.EmployeeListController
<PageTitle>Danh sách nhân viên</PageTitle>

<div class="h-content-filter">
    <div class="card bg-transparent border-0">
        <div class="row g-1 row-gap-1">
            <div class="@(IsShowFilter ? "col-md-4 col-sm-12" : "d-none")">
                <div class="card w1FontSize h-full">
                    <div class="card-header py-1 px-2">
                        <h4 class="mb-0 w1FontSize">Thông tin tìm kiếm</h4>
                    </div>
                    <div class="card-body p-1">
                        <div class="row row-gap-2">
                            <div class="col-sm-12">
                                <div style="height: 100%; max-height: 200px">
                                    <DxGrid Data="ListCboBranch"
                                            ShowFilterRow="true"
                                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                            PagerPosition="GridPagerPosition.Bottom"
                                            PageSizeSelectorVisible="false"
                                            PageSize="@GlobalContants.PageSizeDefault"
                                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                            PageSizeSelectorAllRowsItemVisible="false"
                                            PagerSwitchToInputBoxButtonCount="10"
                                            PagerVisibleNumericButtonCount="10"
                                            TextWrapEnabled="false"
                                            FocusedRowEnabled="true"
                                            SelectionMode="@GridSelectionMode.Multiple"
                                            SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                            AutoExpandAllGroupRows="true"
                                            AllowSelectRowByClick="true"
                                            @bind-SelectedDataItems="@ListCboBranchSelected"
                                            CssClass="h-full">
                                        <Columns>
                                            <DxGridSelectionColumn Width="35px" />
                                            <DxGridDataColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã chi nhánh" MinWidth="100" Width="100px" />
                                            <DxGridDataColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên chi nhánh" MinWidth="150" />
                                        </Columns>
                                    </DxGrid>
                                </div>
                            </div>

                            @if(ListCboDepartment != null && ListCboDepartment.Any())
                            {
                                 <div class="col-sm-12">
                                    <div style="height: 100%; max-height: 200px">
                                        <DxGrid Data="ListCboDepartment"
                                                ShowFilterRow="true"
                                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                PagerPosition="GridPagerPosition.Bottom"
                                                PageSizeSelectorVisible="false"
                                                PageSize="@GlobalContants.PageSizeDefault"
                                                PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                                PageSizeSelectorAllRowsItemVisible="false"
                                                PagerSwitchToInputBoxButtonCount="10"
                                                PagerVisibleNumericButtonCount="10"
                                                TextWrapEnabled="false"
                                                FocusedRowEnabled="true"
                                                SelectionMode="@GridSelectionMode.Multiple"
                                                SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                                AutoExpandAllGroupRows="true"
                                                AllowSelectRowByClick="true"
                                                @bind-SelectedDataItems="@ListCboDepartmentSelected"
                                                CssClass="h-full">
                                            <Columns>
                                                <DxGridSelectionColumn Width="35px" />
                                                <DxGridDataColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã phòng ban" MinWidth="100" Width="100px" />
                                                <DxGridDataColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên phòng ban" MinWidth="150" />
                                            </Columns>
                                        </DxGrid>
                                    </div>
                                </div>                                
                            }
                           
                            <div class="col-sm-12">
                                <div style="height: 100%; max-height: 200px">
                                    <DxGrid Data="ListCboStatus"
                                            ShowFilterRow="true"
                                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                            PagerPosition="GridPagerPosition.Bottom"
                                            PageSizeSelectorVisible="false"
                                            PageSize="@GlobalContants.PageSizeDefault"
                                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                            PageSizeSelectorAllRowsItemVisible="false"
                                            PagerSwitchToInputBoxButtonCount="10"
                                            PagerVisibleNumericButtonCount="10"
                                            TextWrapEnabled="false"
                                            FocusedRowEnabled="true"
                                            SelectionMode="@GridSelectionMode.Multiple"
                                            SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                            AutoExpandAllGroupRows="true"
                                            AllowSelectRowByClick="true"
                                            @bind-SelectedDataItems="@ListCboStatusSelected"
                                            CssClass="h-full">
                                        <Columns>
                                            <DxGridSelectionColumn Width="35px" />
                                            <DxGridDataColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã tình trạng" MinWidth="100" Width="100px" />
                                            <DxGridDataColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên tình trạng" MinWidth="150" />
                                        </Columns>
                                    </DxGrid>
                                </div>
                            </div>
                            <div class="col-sm-12"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="@(IsShowFilter ? "col-md-8 col-sm-12" : "col-md-12 col-sm-12")">
                <div class="row row-gap-2">
                    <div class="col-12">
                        <div class="card w1FontSize">
                            <div class="card-header p-1">
                                <div class="position-absolute" style="z-index: 10">
                                    <i class="@(IsShowFilter ? $"{IconClassConstants.ICON_FILTER_CLEAR}" : $"{IconClassConstants.ICON_FILTER}") @IconClassConstants.FONT_SIZE_ICON"
                                       title="@(IsShowFilter ? "Thu gọn vùng tìm kiếm" : "Mở rộng vùng tìm kiếm")" @onclick="@ShowFilterHandler" />
                                </div>
                                <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                                    <Items>
                                        <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                                       Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />
                                        <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                                       Alignment="@ToolbarItemAlignment.Right" Click="@RedirectPageDetailHandler"
                                                       Visible="@(IsAllowPost)" />
                                        <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                                       Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())"
                                                       Visible="@(IsAllowDelete)" />
                                        <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                                       Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />
                                        <DxToolbarItem Text="Chọn cột" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_GRID}")" CssClass="w1FontSize"
                                                       Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ColumnChooseHandler())" />
                                    </Items>
                                </DxToolbar>
                            </div>
                            <div class="card-header p-0 border-bottom-0">
                                <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                                    <DxTabPage Text="Nhân viên" Id="tabPending" CssClass="w1FontSize"></DxTabPage>
                                    <DxTabPage Text="Nhân viên nghỉ việc" Id="tabAll" CssClass="w1FontSize">

                                    </DxTabPage>
                                </DxTabs>
                            </div>
                            <div class="card-body p-1" style="height: calc(100vh - 200px); min-height: 350px">
                                @switch (ActiveTabIndex)
                                {
                                    case 0:
                                        <DxGrid Data="ListEmployee" @ref="GridEmployee"
                                                ShowFilterRow="true"
                                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                PagerPosition="GridPagerPosition.Bottom"
                                                PageSizeSelectorVisible="true"
                                                PageSize="@GlobalContants.PageSize"
                                                PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                                PageSizeSelectorAllRowsItemVisible="true"
                                                PagerSwitchToInputBoxButtonCount="10"
                                                PagerVisibleNumericButtonCount="10"
                                                TextWrapEnabled="false"
                                                FocusedRowEnabled="true"
                                                SelectionMode="@GridSelectionMode.Multiple"
                                                SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                                @bind-SelectedDataItems="@SelectedEmployees"
                                                AutoExpandAllGroupRows="true"
                                                KeyboardNavigationEnabled="true"
                                                CssClass="h-full">
                                            <Columns>
                                                <DxGridSelectionColumn Width="35px" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.departmentCode)" Caption="Mã phòng ban" MinWidth="120" GroupIndex="0" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.departmentName)" Caption="Tên phòng ban" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.code)" Caption="Mã nhân viên" MinWidth="125">
                                                    <CellDisplayTemplate>
                                                        @{
                                                            <a href="@((context.DataItem as EmployeeModel)!.link)">@context.Value</a>
                                                        }
                                                    </CellDisplayTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.name)" Caption="Tên nhân viên" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.positionName)" Caption="Chức vụ" MinWidth="150" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.titleName)" Caption="Chức danh" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.subDepartmentName)" Caption="Bộ phận" MinWidth="160" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.statusName)" Caption="Trạng thái" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.shiftName)" Caption="Ca làm việc" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.branchName)" Caption="Chi nhánh" MinWidth="150" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.workingBranchName)" Caption="Chi nhánh làm việc" MinWidth="150" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.probationStartDate)" Caption="Ngày thử việc" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.probationEndDate)" Caption="Ngày hết thử việc" MinWidth="130" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.dateOfBirth)" Caption="Ngày sinh" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.gender)" Caption="Giơi tính" MinWidth="90" />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.managerName)" Caption="Quản lý trực tiếp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.managerName2)" Caption="Quản lý gián tiếp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.taxNumber)" Caption="Mã số thuế" MinWidth="130" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.ethnicity)" Caption="Dân tộc" MinWidth="100" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.religion)" Caption="Tôn giáo" MinWidth="100" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.nationality)" Caption="Quốc tịch" MinWidth="100" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.maritalStatusName)" Caption="T/t hôn nhân" MinWidth="110" Visible="false" />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.cIC)" Caption="CCCD/CMND" MinWidth="130" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.issuanceDateCIC)" Caption="Ngày cấp" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfIssuanceCIC)" Caption="Nơi cấp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.expiryDateCIC)" Caption="Ngày hết hạn" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.passportNumber)" Caption="Hộ chiếu" MinWidth="130" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.issueDatePassport)" Caption="Ngày cấp" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfIssuePassport)" Caption="Nơi cấp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.expiryDatePassport)" Caption="Ngày hết hạn" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.phone1)" Caption="Sđt di động" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.phone2)" Caption="Sdt cơ quan" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.email1)" Caption="Email cá nhân" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.email2)" Caption="Email cơ quan" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfOrigin)" Caption="Nguyên quán" MinWidth="150" Visible="false"  />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfResidence)" Caption="Hộ khẩu trường trú" MinWidth="150" Visible="false"  />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.temporaryAddress)" Caption="Chỗ ở hiện nay" MinWidth="150" Visible="false"  />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.userSignName)" Caption="Người tạo" MinWidth="120" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.userSignName)" Caption="Người cập nhật" MinWidth="120" Visible="false" />
                                            </Columns>
                                            <TotalSummary>
                                                <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                                   FieldName="@nameof(EmployeeModel.code)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                                   FooterColumnName="@nameof(EmployeeModel.code)" />
                                            </TotalSummary>
                                        </DxGrid>
                                        break;
                                    case 1:
                                        <DxGrid Data="ListEmployeeOff" @ref="GridEmployeeOff"
                                                ShowFilterRow="true"
                                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                                PagerPosition="GridPagerPosition.Bottom"
                                                PageSizeSelectorVisible="true"
                                                PageSize="@GlobalContants.PageSize"
                                                PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                                PageSizeSelectorAllRowsItemVisible="true"
                                                PagerSwitchToInputBoxButtonCount="10"
                                                PagerVisibleNumericButtonCount="10"
                                                TextWrapEnabled="false"
                                                FocusedRowEnabled="true"
                                                SelectionMode="@GridSelectionMode.Multiple"
                                                SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                                @bind-SelectedDataItems="@SelectedEmployeeOffs"
                                                AutoExpandAllGroupRows="true"
                                                KeyboardNavigationEnabled="true"
                                                CssClass="h-full">
                                            <Columns>
                                                <DxGridSelectionColumn Width="35px" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.departmentCode)" Caption="Mã phòng ban" MinWidth="120" GroupIndex="0" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.departmentName)" Caption="Tên phòng ban" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.code)" Caption="Mã nhân viên" MinWidth="125">
                                                    <CellDisplayTemplate>
                                                        @{
                                                            <a href="@((context.DataItem as EmployeeModel)!.link)">@context.Value</a>
                                                        }
                                                    </CellDisplayTemplate>
                                                </DxGridDataColumn>
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.name)" Caption="Tên nhân viên" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.positionName)" Caption="Chức vụ" MinWidth="150" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.titleName)" Caption="Chức danh" MinWidth="170" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.subDepartmentName)" Caption="Bộ phận" MinWidth="160" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.statusName)" Caption="Trạng thái" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.shiftName)" Caption="Ca làm việc" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.branchName)" Caption="Chi nhánh" MinWidth="150" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.workingBranchName)" Caption="Chi nhánh làm việc" MinWidth="150" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.probationStartDate)" Caption="Ngày thử việc" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.probationEndDate)" Caption="Ngày hết thử việc" MinWidth="130" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.dateOfBirth)" Caption="Ngày sinh" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.gender)" Caption="Giơi tính" MinWidth="90" />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.managerName)" Caption="Quản lý trực tiếp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.managerName2)" Caption="Quản lý gián tiếp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.taxNumber)" Caption="Mã số thuế" MinWidth="130" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.ethnicity)" Caption="Dân tộc" MinWidth="100" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.religion)" Caption="Tôn giáo" MinWidth="100" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.nationality)" Caption="Quốc tịch" MinWidth="100" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.maritalStatusName)" Caption="T/t hôn nhân" MinWidth="110" Visible="false" />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.cIC)" Caption="CCCD/CMND" MinWidth="130" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.issuanceDateCIC)" Caption="Ngày cấp" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfIssuanceCIC)" Caption="Nơi cấp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.expiryDateCIC)" Caption="Ngày hết hạn" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.passportNumber)" Caption="Hộ chiếu" MinWidth="130" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.issueDatePassport)" Caption="Ngày cấp" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfIssuePassport)" Caption="Nơi cấp" MinWidth="150" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.expiryDatePassport)" Caption="Ngày hết hạn" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE" Visible="false" />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.phone1)" Caption="Sđt di động" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.phone2)" Caption="Sdt cơ quan" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.email1)" Caption="Email cá nhân" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.email2)" Caption="Email cơ quan" MinWidth="130" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfOrigin)" Caption="Nguyên quán" MinWidth="150" Visible="false"  />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.placeOfResidence)" Caption="Hộ khẩu trường trú" MinWidth="150" Visible="false"  />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.temporaryAddress)" Caption="Chỗ ở hiện nay" MinWidth="150" Visible="false"  />

                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.userSignName)" Caption="Người tạo" MinWidth="120" Visible="false" />
                                                <DxGridDataColumn FieldName="@nameof(EmployeeModel.userSignName)" Caption="Người cập nhật" MinWidth="120" Visible="false" />
                                            </Columns>
                                            <TotalSummary>
                                                <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                                   FieldName="@nameof(EmployeeModel.code)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                                   FooterColumnName="@nameof(EmployeeModel.code)" />
                                            </TotalSummary>
                                        </DxGrid>
                                        break;
                                }
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Confirm @ref="confirm" />