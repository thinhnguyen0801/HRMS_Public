@page "/chung-tu-quyet-dinh"
@inherits Controllers.DecisionDocumentController
<PageTitle>Chứng từ quyết định</PageTitle>

<div class="h-content-filter">
    <div class="card p-1">
        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
            <Items>
                <DxToolbarItem Text="Duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_APPROVAL}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@ApprovalHandler"
                               Visible="@(IsAllowApproval)" />
                <DxToolbarItem Text="Từ chối" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REJECT}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@(() => RejectHandler())"
                               Visible="@(IsAllowApproval)" />

                <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler"
                               Visible="@(!IsReadonlyControl && ((pActionType == nameof(EnumType.Add) && IsAllowPost) || (pActionType != nameof(EnumType.Add) && IsAllowPut)))" />

                <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@(()=> SubmitForApprovalHandler())"
                               Visible="@(!IsReadonlyControl && RequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@(() => CancelDocumentHandler())"
                               Visible="@(!IsReadonlyControl && pActionType != nameof(EnumType.Add) && RequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                <DxToolbarItem Text="In" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_PRINT}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@PrintDocHandler"
                               Visible="@(pActionType != nameof(EnumType.Add))" />

                <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@RefreshDataHandler" Visible="@(!IsReadonlyControl)" />
            </Items>
        </DxToolbar>
    </div>
    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin quyết định</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@RequestDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@RequestDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Loại quyết định" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboDecisionType"
                                                            Value="@RequestDocument.decisionTypeCode"
                                                            ValueChanged="@((string decisionTypeCode) => ComboboxValueChangedHandler(decisionTypeCode, controlID: nameof(RequestDocument.decisionTypeCode)))"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            Id="decisionTypeCode" ReadOnly="@IsReadonlyControl"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày hiệu lực" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@RequestDocument.effectiveDate"
                                                            CssClass="w1FontSize" Id="effectiveDate" ReadOnly="@IsReadonlyControl"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@RequestDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeSignatureId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@RequestDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(RequestDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@RequestDocument.dateOfSigning"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Lý do" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@RequestDocument.remark" Id="txtRemark" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtghiChu" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ghi chú" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@RequestDocument.noteForAll" Id="txtnoteForAll" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtnoteForAll" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Thông tin nhân viên" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-2">
                    <div style="padding: 5px">
                        @switch (ActiveTabIndex)
                        {
                            case 0:
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nhân viên" Id="txtKiDanhGia" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@RequestDocument.employeeCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@RequestDocument.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(RequestDocument.employeeCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-sm-12">
                                        <div class="row row-gap-2">
                                            <div class="col-md-6 col-sm-12">
                                                <div class="row row-gap-2">
                                                    @* <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Công ty hiện tại" Styles="width: 120px" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <div class="grid gap-1 row-gap-2">
                                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                                        <DxTextBox @bind-Text="@RequestDocument.branchCodeCur" ReadOnly="true" CssClass="w1FontSize" />
                                                                    </div>
                                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                                        <DxTextBox @bind-Text="@RequestDocument.branchNameCur" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div> *@
                                                    <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Phòng ban hiện tại" Styles="width: 120px" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <DxTextBox @bind-Text="@RequestDocument.departmentNameCur" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Chức vụ hiện tại" Styles="width: 120px" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <DxTextBox @bind-Text="@RequestDocument.positionNameCur" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Chức danh hiện tại" Styles="width: 120px" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <DxTextBox @bind-Text="@RequestDocument.titleNameCur" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Bộ phận hiện tại" Styles="width: 120px" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <DxTextBox @bind-Text="@RequestDocument.subDepartmentNameCur" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Nơi làm việc hiện tại" Styles="width: 120px" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <DxTextBox @bind-Text="@RequestDocument.workingBranchNameCur" CssClass="w1FontSize" ReadOnly="true"></DxTextBox>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-12">
                                                <div class="row row-gap-2">
                                                    @* <div class="col-sm-12">
                                                        <div class="d-flex ">
                                                            <W1Label Value="Công ty mới" Styles="width: 120px" IsRequired="true" />
                                                            <div style="width: calc(100% - 120px)">
                                                                <DxComboBox Data="@ListCboBranch"
                                                                            @bind-Value="@RequestDocument.branchIdNew"
                                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                                            Id="branchIdNew" ReadOnly="@IsReadonlyControl"
                                                                            CssClass="w1FontSize">
                                                                </DxComboBox>
                                                            </div>
                                                        </div>
                                                    </div> *@
                                                    @if(RequestDocument.decisionTypeCode != QD_NGHI_VIEC)
                                                    {
                                                        <div class="col-sm-12">
                                                            <div class="d-flex ">
                                                                <W1Label Value="Phòng ban mới" Styles="width: 120px" IsRequired="true" />
                                                                <div style="width: calc(100% - 120px)">
                                                                    <DxComboBox Data="@ListCboDepartment"
                                                                                Value="@RequestDocument.departmentIdNew"
                                                                                ValueChanged="@((int departmentId) => ComboboxValueChangedHandler(departmentId, controlID: nameof(RequestDocument.departmentIdNew)))"
                                                                                FilteringMode="DataGridFilteringMode.Contains"
                                                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                                                ValueFieldName="@nameof(ComboboxModel.id)"
                                                                                Id="departmentIdNew" ReadOnly="@IsReadonlyControl"
                                                                                CssClass="w1FontSize">
                                                                    </DxComboBox>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="d-flex ">
                                                                <W1Label Value="Chức vụ mới" Styles="width: 120px" IsRequired="true" />
                                                                <div style="width: calc(100% - 120px)">
                                                                    <DxComboBox Data="@ListCboPosition"
                                                                                @bind-Value="@RequestDocument.positionIdNew"
                                                                                FilteringMode="DataGridFilteringMode.Contains"
                                                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                                                ValueFieldName="@nameof(ComboboxModel.id)"
                                                                                Id="positionIdNew" ReadOnly="@IsReadonlyControl"
                                                                                CssClass="w1FontSize">
                                                                    </DxComboBox>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="d-flex ">
                                                                <W1Label Value="Chức danh mới" Styles="width: 120px" IsRequired="true" />
                                                                <div style="width: calc(100% - 120px)">
                                                                    <DxComboBox Data="@ListCboTitle"
                                                                                @bind-Value="@RequestDocument.titleIdNew"
                                                                                Id="titleCodeNew" ReadOnly="@IsReadonlyControl"
                                                                                FilteringMode="DataGridFilteringMode.Contains"
                                                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                                                ValueFieldName="@nameof(ComboboxModel.id)"
                                                                                CssClass="w1FontSize">
                                                                    </DxComboBox>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="d-flex ">
                                                                <W1Label Value="Bộ phận mới" Styles="width: 120px" IsRequired="true" />
                                                                <div style="width: calc(100% - 120px)">
                                                                    <DxComboBox Data="@ListCboSubDepartment"
                                                                                @bind-Value="@RequestDocument.subDepartmentIdNew"
                                                                                Id="subDepartmentIdNew" ReadOnly="@IsReadonlyControl"
                                                                                FilteringMode="DataGridFilteringMode.Contains"
                                                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                                                    </DxComboBox>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="d-flex ">
                                                                <W1Label Value="Nơi làm việc mới" Styles="width: 120px" IsRequired="true" />
                                                                <div style="width: calc(100% - 120px)">
                                                                    <DxComboBox Data="@ListCboWorkingBranch"
                                                                                @bind-Value="@RequestDocument.workingBranchIdNew"
                                                                                FilteringMode="DataGridFilteringMode.Contains"
                                                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                                                ValueFieldName="@nameof(ComboboxModel.id)"
                                                                                Id="workingBranchIdNew" ReadOnly="@IsReadonlyControl"
                                                                                CssClass="w1FontSize">
                                                                    </DxComboBox>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    
                                </div>
                                break;
                            case 1:
                                <div style="height: 350px; min-height: 350px; line-height: 20px" class="w1FontSize px-2 py-1 text-truncate">
                                    @((MarkupString)$"{VoucherHistory}")
                                </div>
                                break;
                        }
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="70%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    EnumType="@EnumEmployeeType"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" />
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowPrompt" TextBtnAccept="Xác nhận"
         HeaderText="Xác nhận" Width="55%" HandleClickAccept="@(() => CancelDocumentHandler(isAccept: true))">
    <W1Label Value="Lý do hủy" Styles="width: 120px" IsRequired />
    <div class="mt-1">
        <DxMemo @bind-Text="@ReasonDelete" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtLyDoHuy" CssClass="w1FontSize" />
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowPromptDeny" TextBtnAccept="Xác nhận"
         HeaderText="Xác nhận" Width="55%" HandleClickAccept="@(() => RejectHandler(isAccept: true))">
    <W1Label Value="Lý do từ chối" Styles="width: 120px" IsRequired />
    <div class="mt-1">
        <DxMemo @bind-Text="@ReasonDelete" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtLyDoHuy" CssClass="w1FontSize" />
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />