@page "/danh-sach-hach-toan-chi-phi-luong"
@inherits Controllers.SalaryExpenseAccountingListController
<PageTitle>Danh sách hạch toán chi phí lương</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-md-5 col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Thời gian" Id="txtKiDanhGia" Styles="width: 80px" />
                <div style="width: calc(100% - 80px)">
                    <div class="grid gap-1 row-gap-2">
                        <div class="g-col-md-6 g-col-sm-12 g-col-12">
                            <DxDateEdit @bind-Date="@FromDate" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                        Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize" />
                        </div>
                        <div class="g-col-md-6 g-col-sm-12 g-col-12">
                            <DxDateEdit @bind-Date="@ToDate" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                        Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE" CssClass="w1FontSize" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />
                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@RedirectPageDetailHandler" Visible="@(IsAllowPost)" />
                            <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Visible="@(IsAllowDelete)" />
                            <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Chờ xử lý" Id="tabPending" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Tất cả" Id="tabAll" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 230px); min-height: 350px">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <DxGrid Data="ListPending" @ref="GridPending"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.voucherNo)" Caption="Mã chứng từ" MinWidth="140">
                                        <CellDisplayTemplate>
                                            @{
                                                <a href="@($"{(context.DataItem as SalaryExpenseAccountingModel)!.link}")">@context.Value</a>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.docDate)" Caption="Ngày chứng từ" DisplayFormat="@GlobalContants.FORMAT_DATE" MinWidth="120" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.branchName)" Caption="Chi nhánh" MinWidth="150" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.statusName)" Caption="Trạng thái" MinWidth="130" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.employeeSignatureName)" Caption="Nhân viên ký" MinWidth="150" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.month)" Caption="Tháng" MinWidth="90" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.year)" Caption="Năm" MinWidth="90" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.docTotal)" Caption="Tổng tiền" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.userSignName)" Caption="Người cập nhật" MinWidth="120" />
                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                       FieldName="@nameof(OvertimeRequestModel.voucherNo)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(OvertimeRequestModel.voucherNo)" />
                                </TotalSummary>
                            </DxGrid>
                            break;
                        case 1:
                            <DxGrid Data="ListAll" @ref="GridAll"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.voucherNo)" Caption="Mã chứng từ" MinWidth="140">
                                        <CellDisplayTemplate>
                                            @{
                                                <a href="@($"{(context.DataItem as SalaryExpenseAccountingModel)!.link}")">@context.Value</a>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.docDate)" Caption="Ngày chứng từ" DisplayFormat="@GlobalContants.FORMAT_DATE" MinWidth="120" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.branchName)" Caption="Chi nhánh" MinWidth="150" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.statusName)" Caption="Trạng thái" MinWidth="130" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.employeeSignatureName)" Caption="Nhân viên ký" MinWidth="150" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.month)" Caption="Tháng" MinWidth="90" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.year)" Caption="Năm" MinWidth="90" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.docTotal)" Caption="Tổng tiền" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                                    <DxGridDataColumn FieldName="@nameof(SalaryExpenseAccountingModel.userSignName)" Caption="Người cập nhật" MinWidth="120" />
                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                       FieldName="@nameof(ShiftChangeModel.voucherNo)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(ShiftChangeModel.voucherNo)" />
                                </TotalSummary>
                            </DxGrid>
                            break;
                    }

                </div>
            </div>
        </div>
    </div>
</div>
