@page "/tinh-luong-thang"
@inherits Controllers.MonthlySalaryCalculationController
<PageTitle>Tính lương nhân viên</PageTitle>

<div class="h-content-filter">
    <div class="card card-lg" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin tìm kiếm</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-8 col-sm-12">
                                        <div class="row row-gap-2">
                                            <div class="col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Phòng ban" Styles="width: 100px" IsRequired="true" />
                                                    <div style="width: calc(100% - 100px)">
                                                        <DxTagBox Data="@ListCboDepartment"
                                                                  @bind-Values="@ListDepartmentSelected" CssClass="w1FontSize"
                                                                  DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                                                  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                                  TextFieldName="@nameof(ComboboxModel.name)">
                                                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                                        </DxTagBox>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Trạng thái" Styles="width: 100px" IsRequired="true" />
                                                    <div style="width: calc(100% - 100px)">
                                                        <DxTagBox Data="@ListCboStatus"
                                                                  @bind-Values="@ListCboStatusSelected" CssClass="w1FontSize"
                                                                  DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                                                  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                                  TextFieldName="@nameof(ComboboxModel.name)">
                                                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                                        </DxTagBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="row row-gap-2">
                                            <div class="col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Tháng/năm" Styles="width: 100px" IsRequired="true" />
                                                    <div style="width: calc(100% - 100px)">
                                                        <div class="grid gap-1 row-gap-2">
                                                            <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                                <DxComboBox Data="@ListCboMonth"
                                                                            @bind-Value="@SearchUpdate.month"
                                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                                            CssClass="w1FontSize">
                                                                </DxComboBox>
                                                            </div>
                                                            <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                                <DxComboBox Data="@ListCboYear"
                                                                            @bind-Value="@SearchUpdate.year"
                                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                                            CssClass="w1FontSize">
                                                                </DxComboBox>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-sm-12">
                                                <div class="d-flex ">
                                                    <W1Label Value="Nhân viên" Id="txtKiDanhGia" Styles="width: 100px" IsRequired="true" />
                                                    <div style="width: calc(100% - 100px)">
                                                        <DxTextBox @bind-Text="@SearchUpdate.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(SearchUpdate.employeeCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
             <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>

                            <DxToolbarItem Text="Tính lương" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_CALCULATOR}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />

                            <DxToolbarItem Text="Lưu lương tháng" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler" />

                            <DxToolbarItem Text="Chốt lương" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_TABLE_LOCK}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@LockPayrollEmployeeHandler" />

                            <DxToolbarItem Text="Chốt lương chi nhánh" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_TABLE_LOCK}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@LockPayrollBranchHandler" />

                            <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />

                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Bảng lương" Id="tabBL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Trích nộp" Id="tabTN" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Thuế thu nhập cá nhân" Id="tabTTNCN" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 190px); min-height: 450px">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <DxGrid Data="ListSalary" @ref="GridSalary"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    SelectionMode="GridSelectionMode.Multiple"
                                    @bind-SelectedDataItems="@SelectedItems"
                                    AllowSelectRowByClick="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.departmentName)" Caption="Phòng ban" Width="145px" MinWidth="120" GroupIndex="0" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridSelectionColumn Width="45px" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.employeeCode)" Caption="Mã nhân viên" Width="110px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.employeeName)" Caption="Họ tên" Width="135px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.isLocked)" Caption="Đã chốt?" Width="90px" MinWidth="70" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.month)" Caption="Tháng" MinWidth="70" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.year)" Caption="Năm" MinWidth="70" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.basicSalary)" Caption="Lương cơ bản" MinWidth="90" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương</div>
                                            <div>Cơ bản</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.negotiatedSalary)" Caption="Lương thỏa thuận" MinWidth="90" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương</div>
                                            <div>Thỏa thuận</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.salaryCoefficient)" Caption="HSL" MinWidth="60" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.convertedNegotiatedSalary)" Caption="Lương quy đổi" MinWidth="90" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương</div>
                                            <div>Quy đổi <span style="color: red;">&nbsp;(*)</span></div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.totalSalaryNet)" Caption="Tổng lương thực nhận" MinWidth="110" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Tổng lương</div>
                                            <div>Thực nhận <span style="color: red;">&nbsp;(*)</span></div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.totalSalaryGross)" Caption="Tổng thu nhập trước thuế" MinWidth="110" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Tổng thu nhập</div>
                                            <div>Trước thuế <span style="color: red;">&nbsp;(*)</span></div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.allowanceSalary)" Caption="Tổng phụ cấp" MinWidth="110" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Tổng</div>
                                            <div>Phụ cấp <span style="color: red;">&nbsp;(*)</span></div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.totalDeductionEmployee)" Caption="Tổng trích nộp" MinWidth="110"
                                                      CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Tổng</div>
                                            <div>Trích nộp <span style="color: red;">&nbsp;(*)</span></div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.taxPayment)" Caption="Tổng thuế TNCN" MinWidth="110" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Tổng</div>
                                            <div>Thuế TNCN <span style="color: red;">&nbsp;(*)</span></div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.isCompanyInsurance)" Caption="Công ty đóng trích nộp thay?" Width="90px" MinWidth="80" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Công ty</div>
                                            <div>Đóng TN?</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.isCompanyDeduction)" Caption="Công ty đóng thuế thay?" Width="90px" MinWidth="80" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Công ty</div>
                                            <div>Đóng thuế?</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.tNC)" Caption="Tổng ngày công" MinWidth="80" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Tổng</div>
                                            <div>Ngày công</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.cDM)" Caption="Công định mức" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Công</div>
                                            <div>Định mức</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.gCDM)" Caption="Giờ công định mức" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Giờ công</div>
                                            <div>Định mức</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.cTT)" Caption="Công thực tế" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Công</div>
                                            <div>Thực tế</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.nPN)" Caption="Công phép năm" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Công</div>
                                            <div>Phép năm</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.nCD)" Caption="Công chế độ" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Công</div>
                                            <div>Chế độ</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.nL)" Caption="Công nghỉ lễ" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Công</div>
                                            <div>Nghỉ lễ</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.cTPC)" Caption="Công phụ cấp" MinWidth="70" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Công</div>
                                            <div>Phụ cấp</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.tGTC)" Caption="Giờ công tăng ca" MinWidth="80" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Giờ công</div>
                                            <div>Tăng ca</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.sGT)" Caption="Giờ công thiếu" MinWidth="80" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Giờ công</div>
                                            <div>Thiếu</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.tGDLTVS)" Caption="Số phút đi trễ về sớm" MinWidth="80" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div title="Số phút đi trễ về sớm">Số phút</div>
                                            <div>+/-</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.actualSalary)" Caption="Lương công thực tế" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương công</div>
                                            <div>Thực tế</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.annualLeaveSalary)" Caption="Lương công phép năm" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương công</div>
                                            <div>Phép năm</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.regulatedSalary)" Caption="Lương công chế độ" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương công</div>
                                            <div>Chế độ</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.holidaySalary)" Caption="Lương nghỉ lễ" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương</div>
                                            <div>Nghỉ lễ</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.overtimeSalary)" Caption="Lương công Tăng ca" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương công</div>
                                            <div>Tăng ca</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.missingWorkingHourSalary)" Caption="Lương giờ thiếu" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div>Lương</div>
                                            <div>Giờ thiếu</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.lateSalary)" Caption="Lương đi trễ về sớm" MinWidth="100" 
                                        CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_CURRENCY">
                                        <HeaderCaptionTemplate>
                                            <div title="Lương đi trễ về sớm">Lương</div>
                                            <div>+/-</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM_PAYROLL" SummaryType="GridSummaryItemType.Sum"
                                                       FieldName="@nameof(PayrollModel.allowanceSalary)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(PayrollModel.allowanceSalary)" />

                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM_PAYROLL" SummaryType="GridSummaryItemType.Sum"
                                                       FieldName="@nameof(PayrollModel.taxPayment)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(PayrollModel.taxPayment)" />

                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM_PAYROLL" SummaryType="GridSummaryItemType.Sum"
                                                       FieldName="@nameof(PayrollModel.totalDeductionEmployee)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(PayrollModel.totalDeductionEmployee)" />

                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM_PAYROLL" SummaryType="GridSummaryItemType.Sum"
                                                       FieldName="@nameof(PayrollModel.totalSalaryGross)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(PayrollModel.totalSalaryGross)" />

                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM_PAYROLL" SummaryType="GridSummaryItemType.Sum"
                                                       FieldName="@nameof(PayrollModel.totalSalaryNet)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(PayrollModel.totalSalaryNet)" />
                                </TotalSummary>
                            </DxGrid>
                            break;
                        case 1:
                            <DxGrid Data="ListSalary" @ref="GridInsuranceSalary"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    SelectionMode="GridSelectionMode.Multiple"
                                    AllowSelectRowByClick="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.departmentName)" Caption="Phòng ban" Width="145px" MinWidth="120" GroupIndex="0" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridSelectionColumn Width="45px" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.employeeCode)" Caption="Mã nhân viên" Width="110px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.employeeName)" Caption="Họ tên" Width="135px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.isLocked)" Caption="Đã chốt?" Width="90px" MinWidth="70" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.month)" Caption="Tháng" MinWidth="70" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.year)" Caption="Năm" MinWidth="70" DisplayFormat="d" />
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.isCompanyInsurance)" Caption="Công ty đóng thay?" Width="90px" MinWidth="80" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Công ty</div>
                                            <div>Đóng thay?</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(PayrollModel.totalDeduction)" Caption="Tổng cộng" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
