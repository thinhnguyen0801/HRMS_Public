@page "/khen-thuong-phu-cap"
@inherits Controllers.RewardAllowanceRequestController
<PageTitle>Khen thưởng & phụ cấp</PageTitle>

<div class="h-content-filter">
    @if (!IsReadonlyControl)
    {
        <div class="card p-1">
            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                <Items>
                    <DxToolbarItem Text="Duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_APPROVAL}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@ApprovalHandler"
                                   Visible="@(IsAllowApproval)" />
                    <DxToolbarItem Text="Từ chối" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REJECT}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(() => RejectHandler())"
                                   Visible="@(IsAllowApproval)" />

                    <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler"
                                   Visible="@(!IsReadonlyControl && ((pActionType == nameof(EnumType.Add) && IsAllowPost) || (pActionType != nameof(EnumType.Add) && IsAllowPut)))" />

                    <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(()=> SubmitForApprovalHandler())"
                                   Visible="@(!IsReadonlyControl && RequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                    <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(() => CancelDocumentHandler())"
                                   Visible="@(!IsReadonlyControl && pActionType != nameof(EnumType.Add) && RequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshDataHandler" Visible="@(!IsReadonlyControl)" />
                </Items>
            </DxToolbar>
        </div>
    }
    else if (IsReadonlyControl && IsAllowCancel && RequestDocument.statusCode == CommonConstants.STATUS_CODE_APPROVED)
    {
       @* Để cho PNS hủy phiếu khi phiếu đã duyệt *@
       <div class="card p-1">
            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                <Items>
                    <DxToolbarItem Text="Hủy phiếu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_CANCEL}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(() => CancelDocumentHandler())"  />
                </Items>
            </DxToolbar>
        </div>
    }

    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin khen thưởng & phụ cấp</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@RequestDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@RequestDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@RequestDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeSignatureId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@RequestDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(RequestDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@RequestDocument.dateOfSigning"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Loại khen thưởng" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboVoucherType"
                                                            @bind-Value="@RequestDocument.salaryConfigId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(SalaryConfigurationModel.salaryCategoryName)"
                                                            ValueFieldName="@nameof(SalaryConfigurationModel.id)"
                                                            Id="salaryConfigId" ReadOnly="@IsReadonlyControl"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tên đợt" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@RequestDocument.rewardName" ReadOnly="@IsReadonlyControl" CssClass="w1FontSize" Id="rewardName" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Tháng thưởng" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@RequestDocument.rewardDate" DisplayFormat="MM/yyyy"
                                                            Mask="MM/yyyy" Format="MM/yyyy" CssClass="w1FontSize"
                                                            MinDate="@GlobalContants.MIN_DATE" ReadOnly="@IsReadonlyControl"
                                                            PickerDisplayMode="@DatePickerDisplayMode.ScrollPicker" ScrollPickerFormat="MM yyyy">

                                                </DxDateEdit>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Tháng chi trả" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@RequestDocument.rewardPaymentDate" DisplayFormat="MM/yyyy"
                                                            Mask="MM/yyyy" Format="MM/yyyy" CssClass="w1FontSize"
                                                            MinDate="@GlobalContants.MIN_DATE" ReadOnly="@IsReadonlyControl"
                                                            PickerDisplayMode="@DatePickerDisplayMode.ScrollPicker" ScrollPickerFormat="MM yyyy">

                                                </DxDateEdit>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nội dung" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@RequestDocument.noteForAll" Id="txtnoteForAll" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtnoteForAll" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Danh sách nhân viên" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListEmployeeReward" @ref="GridEmployeeReward"
                                        ShowFilterRow="false"
                                        PageSize="10000"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldNames="@(new [] {nameof(RewardAllowanceRequest1Model.employeeId),nameof(RewardAllowanceRequest1Model.id)})"
                                        ValidationEnabled="true"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="@GridRewardAllowanceEditSavingHandler"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Multiple"
                                        SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                        AutoExpandAllGroupRows="true"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_DOWN" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Điền tiền thưởng & giới hạn theo loại"
                                                               Visible="@(!IsReadonlyControl)" 
                                                               Click="@FillSalaryByVoucherTypeHandler" />

                                                @* <DxToolbarItem IconCssClass="@IconClassConstants.ICON_CALCULATOR" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Tính toán tiền lương theo bảng công"
                                                               Visible="@(!IsReadonlyControl)" 
                                                               Click="@SalaryCalculateHandler" /> *@

                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_ADD" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Thêm nhân viên"
                                                               Visible="@(!IsReadonlyControl)"
                                                               Click="@(async () => await OpenPopupHandler(nameof(ListEmpSelected), nameof(ListEmpSelected)))" />

                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_DELETE" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Xóa nhân viên"
                                                               Visible="@(!IsReadonlyControl)"
                                                               Click="@DeleteDataHandler" />

                                                @* <DxToolbarItem IconCssClass="@IconClassConstants.ICON_GRID" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Chọn cột hiển thị"
                                                               Click="@ColumnChooseHandler" /> *@
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridSelectionColumn Width="35px" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.departmentName)" Caption="Phòng ban" MinWidth="170" GroupIndex="0" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.employeeCode)" Caption="Mã nhân viên" MinWidth="120" Width="120px" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.employeeName)" Caption="Tên nhân viên" MinWidth="160" Width="160px" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.salaryCalculateMethodName)" Caption="Cách tính phụ cấp" MinWidth="140" Width="140px" DataRowEditorVisible="false" />
                                        @* <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.cDM)" Caption="CĐM" MinWidth="65" Width="65px" DisplayFormat="@GlobalContants.FORMAT_NUMBER" DataRowEditorVisible="false" Visible="false" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.cTT)" Caption="CTT" MinWidth="65" Width="65px" DisplayFormat="@GlobalContants.FORMAT_NUMBER" DataRowEditorVisible="false" Visible="false" /> *@
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.rewardAmount)" Caption="Tiền thưởng" MinWidth="125" Width="125px"
                                                          DisplayFormat="@GlobalContants.FORMAT_CURRENCY" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Tiền thưởng <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                            <EditSettings>
                                                <DxSpinEditSettings DisplayFormat="@GlobalContants.FORMAT_CURRENCY" InputCssClass="text-end"
                                                                    Mask="@GlobalContants.FORMAT_CURRENCY" MinValue="0m" ReadOnly="@IsReadonlyControl" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.paidAmount)" Caption="Tiền chi trả" MinWidth="125" Width="125px"
                                                          DisplayFormat="@GlobalContants.FORMAT_CURRENCY" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Tiền chi trả <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                            <EditSettings>
                                                <DxSpinEditSettings DisplayFormat="@GlobalContants.FORMAT_CURRENCY" InputCssClass="text-end"
                                                                    Mask="@GlobalContants.FORMAT_CURRENCY" MinValue="0m" ReadOnly="@IsReadonlyControl" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.taxPayment)" Caption="Tiền thuế" MinWidth="125" Width="125px"
                                                          DisplayFormat="@GlobalContants.FORMAT_CURRENCY" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Tiền thuế <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                            <EditSettings>
                                                <DxSpinEditSettings DisplayFormat="@GlobalContants.FORMAT_CURRENCY" InputCssClass="text-end"
                                                                    Mask="@GlobalContants.FORMAT_CURRENCY" MinValue="0m" ReadOnly="@IsReadonlyControl" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.totalSalary)" Caption="Tổng tiền" MinWidth="125" Width="125px" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.maxSalary)" Caption="Giới hạn" MinWidth="125" Width="125px"
                                                          DisplayFormat="@GlobalContants.FORMAT_CURRENCY" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Giới hạn <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                            <EditSettings>
                                                <DxSpinEditSettings DisplayFormat="@GlobalContants.FORMAT_CURRENCY" InputCssClass="text-end"
                                                                    Mask="@GlobalContants.FORMAT_CURRENCY" MinValue="0m" ReadOnly="@IsReadonlyControl" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.netSalary)" Caption="Thực lãnh" MinWidth="125" Width="125px" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(RewardAllowanceRequest1Model.remark)" Caption="Ghi chú" MinWidth="170" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Ghi chú <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                    </Columns>
                                    <TotalSummary>
                                        <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM" SummaryType="GridSummaryItemType.Sum"
                                                           FieldName="@nameof(RewardAllowanceRequest1Model.rewardAmount)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                           FooterColumnName="@nameof(RewardAllowanceRequest1Model.rewardAmount)" />
                                        <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM" SummaryType="GridSummaryItemType.Sum"
                                                           FieldName="@nameof(RewardAllowanceRequest1Model.paidAmount)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                           FooterColumnName="@nameof(RewardAllowanceRequest1Model.paidAmount)" />
                                        <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM" SummaryType="GridSummaryItemType.Sum"
                                                           FieldName="@nameof(RewardAllowanceRequest1Model.taxPayment)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                           FooterColumnName="@nameof(RewardAllowanceRequest1Model.taxPayment)" />
                                        <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM" SummaryType="GridSummaryItemType.Sum"
                                                           FieldName="@nameof(RewardAllowanceRequest1Model.totalSalary)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                           FooterColumnName="@nameof(RewardAllowanceRequest1Model.totalSalary)" />
                                        <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM" SummaryType="GridSummaryItemType.Sum"
                                                           FieldName="@nameof(RewardAllowanceRequest1Model.netSalary)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                           FooterColumnName="@nameof(RewardAllowanceRequest1Model.netSalary)" />
                                    </TotalSummary>
                                </DxGrid>
                            </div>
                            break;
                        case 1:
                            <div style="height: 350px; min-height: 350px; line-height: 20px" class="w1FontSize px-2 py-1 text-truncate">
                                @((MarkupString)$"{VoucherHistory}")
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="70%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    SelectionMode="@DxGridEmployeeSelectionMode" EnumType="@CommonConstants.ENUM_EMPLOYEE_SIGNATURE"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" SelectedDataItemsChanged="@EventCallbackEmpListChangedHandler" />
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowPrompt" TextBtnAccept="Xác nhận"
         HeaderText="Xác nhận" Width="55%" HandleClickAccept="@(() => CancelDocumentHandler(isAccept: true))">
    <W1Label Value="Lý do hủy" Styles="width: 120px" IsRequired />
    <div class="mt-1">
        <DxMemo @bind-Text="@ReasonDelete" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtLyDoHuy" CssClass="w1FontSize" />
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowPromptDeny" TextBtnAccept="Xác nhận"
         HeaderText="Xác nhận" Width="55%" HandleClickAccept="@(() => RejectHandler(isAccept: true))">
    <W1Label Value="Lý do từ chối" Styles="width: 120px" IsRequired />
    <div class="mt-1">
        <DxMemo @bind-Text="@ReasonDelete" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtLyDoHuy" CssClass="w1FontSize" />
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />