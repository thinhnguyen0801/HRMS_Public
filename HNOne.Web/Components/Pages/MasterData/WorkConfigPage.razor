@page "/cau-hinh-thong-so-cong"
@inherits Controllers.WorkConfigController

<PageTitle>Thông số công làm việc</PageTitle>

<div class="h-content-filter">
    <div class="card p-1">
        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
            <Items>
                <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />

                <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler" Visible="@(IsAllowPut)" />

            </Items>
        </DxToolbar>
    </div>

    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông số công</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Chi nhánh" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <DxComboBox Data="@ListCboBranch"
                                                            @bind-Value="@WorkConfigUpdate.branchId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            Id="txtBranchId"
                                                            CssClass="w1FontSize"
                                                            ValueFieldName="@nameof(ComboboxModel.id)">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12"></div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày b/đ chấm công" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxSpinEdit @bind-Value="@WorkConfigUpdate.startDate" MinValue="1" Increment="1" Id="txtstartDate"
                                                                    InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxComboBox Data="@ListCboYear"
                                                                    @bind-Value="@WorkConfigUpdate.year"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.name)"
                                                                    ValueFieldName="@nameof(ComboboxModel.id)"
                                                                    CssClass="w1FontSize">
                                                        </DxComboBox>
                                                    </div>
                                                </div>
                                                
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày chốt kỳ công" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxSpinEdit @bind-Value="@WorkConfigUpdate.closingDate" MinValue="1" Increment="1" Id="txtclosingDate"
                                                                    InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày k/t chấm công" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxSpinEdit @bind-Value="@WorkConfigUpdate.closingDate1" Id="txtclosingDate1"
                                                                    MinValue="0" Increment="1" ReadOnly="@WorkConfigUpdate.isLastDayOfMonth"
                                                                    InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxCheckBox CssClass="w-100 w1FontSize"
                                                                    SizeMode="@SizeMode.Small"
                                                                    @bind-Checked="@WorkConfigUpdate.isLastDayOfMonth"
                                                                    LabelPosition="@LabelPosition.Right">
                                                            Cuối tháng?
                                                        </DxCheckBox>
                                                    </div>
                                                </div>
                                                
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số ngày làm việc" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxSpinEdit @bind-Value="@WorkConfigUpdate.totalWorkingDayOfMonth" Id="txttotalWorkingDayOfMonth"
                                                                    MinValue="0" Increment="1.0" ReadOnly="@WorkConfigUpdate.isWorkingDayExcludeDayOff"
                                                                    InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxCheckBox CssClass="w-100 w1FontSize"
                                                                    SizeMode="@SizeMode.Small"
                                                                    @bind-Checked="@WorkConfigUpdate.isWorkingDayExcludeDayOff"
                                                                    LabelPosition="@LabelPosition.Right">
                                                            Chỉ loại trừ ngày nghỉ?
                                                        </DxCheckBox>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ký hiệu/số giờ làm việc" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.symbolWorkingDay" CssClass="w1FontSize" Id="txtsymbolWorkingDay" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxSpinEdit @bind-Value="@WorkConfigUpdate.totalWorkingHours" MinValue="0" Increment="1" Id="txttotalWorkingHours"
                                                                    InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ký hiệu ngày nghỉ tuần" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.symbolOfWeekdayDayOff" CssClass="w1FontSize" Id="txtsymbolOfWeekdayDayOff" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.bgColorOfWeekdayDayOff" CssClass="w1FontSize" NullText="Màu ngày nghỉ" />
                                                    </div>
                                                </div>
                                                
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ký hiệu ngày nghỉ lễ" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.symbolOfHoliday" CssClass="w1FontSize" Id="txtsymbolOfHoliday" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.bgColorOfHoliday" CssClass="w1FontSize" NullText="Màu ngày nghỉ" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ký hiệu ngày nghỉ phép" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.symbolOfLeaveOfAbsence" CssClass="w1FontSize" Id="symbolOfLeaveOfAbsence" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.bgColorOfLeaveOfAbsence" CssClass="w1FontSize" NullText="Màu ngày nghỉ" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ký hiệu NP không lương" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.symbolOfUnpaidLeave" CssClass="w1FontSize" Id="symbolOfUnpaidLeave" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.bgColorOfUnpaidLeave" CssClass="w1FontSize" NullText="Màu ngày nghỉ" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ký hiệu tăng ca" Styles="width: 140px" IsRequired="true" />
                                            <div style="width: calc(100% - 140px)">
                                                <div class="row row-gap-2">
                                                    <div class="col-md-7 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.symbolOfOvertime" CssClass="w1FontSize" Id="symbolOfOvertime" />
                                                    </div>
                                                    <div class="col-md-5 col-sm-12">
                                                        <DxTextBox @bind-Text="@WorkConfigUpdate.bgColorOfOvertime" CssClass="w1FontSize" NullText="Màu ngày nghỉ" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-lg mt-1 mb-3" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-1">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông số công chi tiết</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-1" class="accordion-collapse collapse show" data-bs-parent="#accordion-1">
                            <div class="accordion-body p-1" style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListWorkConfig" @ref="GridWorkConfig"
                                        ShowFilterRow="false"
                                        PageSize="500"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldNames="@(new [] {nameof(WorkConfigModel.year),nameof(WorkConfigModel.month)})"
                                        ValidationEnabled="true"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Single"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_PREVIEW" BeginGroup="true"
                                                               Text="Xem trước" CssClass="w1FontSize"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Phát sinh công chi tiết"
                                                               Click="@PreviewWorkConfigHandler" Visible="@(IsAllowPost)" />
                                                @* <DxToolbarItem IconCssClass="@IconClassConstants.ICON_ADD" BeginGroup="true"
                                                               Text="Phát sinh"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Phát sinh công chi tiết"
                                                               Click="@GenerateWorkHandler" Visible="@(IsAllowPost)" /> *@
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.branchName)" Caption="Chi nhánh" MinWidth="160" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.month)" Caption="Tháng" MinWidth="70" Width="80px" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.totalWorkingDayOfMonthD)" Caption="Công tiêu chuẩn" Width="130px" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_NUMBER" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.isWorkingDayExcludeDayOff)" Caption="Loại trừ ngày nghỉ?" MinWidth="110" Width="120px" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.totalWorkingHoursD)" Caption="Số giờ làm việc" Width="135px" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_NUMBER" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.startDateD)" Caption="Ngày b/đ chấm công" Width="135px" MinWidth="110" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.closingDateD)" Caption="Ngày chốt công" Width="130px" MinWidth="110" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.closingDate1D)" Caption="Ngày k/t chấm công" Width="140px" MinWidth="130" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.isLastDayOfMonth)" Caption="Cuối tháng?" MinWidth="80" Width="90px" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolWorkingDay)" Caption="KHLV" MinWidth="60" Width="70px" />
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfWeekdayDayOff)" Caption="KHNNT" MinWidth="70">
                                            <CellDisplayTemplate>
                                                @{
                                                    <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfWeekdayDayOff}")">@context.Value</span>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfHoliday)" Caption="KHNNL" MinWidth="70">
                                            <CellDisplayTemplate>
                                                @{
                                                    <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfHoliday}")">@context.Value</span>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfLeaveOfAbsence)" Caption="KHNP" MinWidth="70">
                                            <CellDisplayTemplate>
                                                @{
                                                    <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfLeaveOfAbsence}")">@context.Value</span>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfUnpaidLeave)" Caption="KHNNPKL" MinWidth="70">
                                            <CellDisplayTemplate>
                                                @{
                                                    <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfUnpaidLeave}")">@context.Value</span>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfOvertime)" Caption="KHNTC" MinWidth="70">
                                            <CellDisplayTemplate>
                                                @{
                                                    <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfOvertime}")">@context.Value</span>
                                                }
                                            </CellDisplayTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(LeaveConfigModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveConfigModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialogPreview" Width="85%"
         TextBtnAccept="Lưu phát sinh công"
         IsShowFooter="true"
         HandleClickAccept="@GenerateWorkHandler"
         HeaderText="Xem trước công phát sinh chi tiết">
    <div style="height: 400px; min-height: 350px">
        <DxGrid Data="ListWorkConfigPreView" @ref="GridWorkConfigPreview"
                ShowFilterRow="false"
                PageSize="500"
                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                PagerPosition="GridPagerPosition.Bottom"
                PageSizeSelectorVisible="false"
                PageSizeSelectorAllRowsItemVisible="false"
                PagerSwitchToInputBoxButtonCount="10"
                PagerVisibleNumericButtonCount="10"
                TextWrapEnabled="false"
                KeyFieldNames="@(new [] {nameof(WorkConfigModel.year),nameof(WorkConfigModel.month)})"
                ValidationEnabled="true"
                KeyboardNavigationEnabled="true"
                AllowSelectRowByClick="true"
                FocusedRowEnabled="true"
                SelectionMode="GridSelectionMode.Single"
                CssClass="h-full">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.branchName)" Caption="Chi nhánh" MinWidth="160" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.month)" Caption="Tháng" MinWidth="70" Width="80px" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.totalWorkingDayOfMonthD)" Caption="Công tiêu chuẩn" Width="130px" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_NUMBER" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.isWorkingDayExcludeDayOff)" Caption="Loại trừ ngày nghỉ?" MinWidth="110" Width="120px" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.totalWorkingHoursD)" Caption="Số giờ làm việc" Width="135px" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_NUMBER" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.startDateD)" Caption="Ngày b/đ chấm công" Width="135px" MinWidth="110" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.closingDateD)" Caption="Ngày chốt công" Width="130px" MinWidth="110" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.closingDate1D)" Caption="Ngày k/t chấm công" Width="140px" MinWidth="130" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.isLastDayOfMonth)" Caption="Cuối tháng?" MinWidth="80" Width="90px" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolWorkingDay)" Caption="KHLV" MinWidth="60" Width="70px" />
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfWeekdayDayOff)" Caption="KHNNT" MinWidth="70">
                    <CellDisplayTemplate>
                        @{
                            <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfWeekdayDayOff}")">@context.Value</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfHoliday)" Caption="KHNNL" MinWidth="70">
                    <CellDisplayTemplate>
                        @{
                            <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfHoliday}")">@context.Value</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfLeaveOfAbsence)" Caption="KHNP" MinWidth="70">
                    <CellDisplayTemplate>
                        @{
                            <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfLeaveOfAbsence}")">@context.Value</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfUnpaidLeave)" Caption="KHNNPKL" MinWidth="70">
                    <CellDisplayTemplate>
                        @{
                            <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfUnpaidLeave}")">@context.Value</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(WorkConfigModel.symbolOfOvertime)" Caption="KHNTC" MinWidth="70">
                    <CellDisplayTemplate>
                        @{
                            <span style="padding: 2px;background-color: @($"{(context.DataItem as WorkConfigModel)!.bgColorOfOvertime}")">@context.Value</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />