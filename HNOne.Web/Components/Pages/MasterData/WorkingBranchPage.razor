@page "/chi-nhanh-lam-viec"
@inherits Controllers.WorkingBranchController

<PageTitle>Chi nhánh làm việc</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />
                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />

                            <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListWorkingBranch" @ref="GridWorkingBranch"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                            @bind-SelectedDataItems="@SelectedWorkingBranchs"
                            KeyFieldName="@nameof(WorkingBranchModel.id)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.id)" Caption="ID" MinWidth="80" Width="90px">
                                <CellDisplayTemplate>
                                    @{
                                        if (IsAllowPut)
                                        {
                                            <a @onclick="@(() => OnOpenDialogHandler(EnumType.Update, (context.DataItem as WorkingBranchModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.name)" Caption="Tên vị trí" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.branchName)" Caption="Chi nhánh" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.remark)" Caption="Ghi chú" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(WorkingBranchModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(WorkingBranchModel.name)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(WorkingBranchModel.name)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="60%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreate ? "Thêm mới vị trí làm việc" : $"Cập nhật vị trí làm việc")"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tên vị trí" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@WBranchUpdate.name" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Chi nhánh" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxComboBox Data="@ListCboBranch"
                                @bind-Value="@WBranchUpdate.branchId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                Id="txtBranchId"
                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Ghi chú" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxMemo @bind-Text="@WBranchUpdate.remark" CssClass="w1FontSize" BindValueMode="@BindValueMode.OnInput" Rows="2" />
                </div>
            </div>
        </div>
    </div>
</W1Popup>


<W1Confirm @ref="confirm" />