@page "/ly-do"
@inherits Controllers.ReasonCategorieController

<PageTitle>Danh mục lý do</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />

                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListReasonCategorie" @ref="GridReasonCategorie"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedReasonCategories"
                            KeyFieldName="@nameof(ReasonCategorieModel.name)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(ReasonCategorieModel.name)" Caption="Tên danh mục lý do" MinWidth="190" >
                                <CellDisplayTemplate>
                                    @{
                                        if(IsAllowPut)
                                        {
                                            <a @onclick="@(() => OnOpenDialogHandler(EnumType.Update, (context.DataItem as ReasonCategorieModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>/>
                            <DxGridDataColumn FieldName="@nameof(ReasonCategorieModel.type)" Caption="Loại lý do" MinWidth="110" />
                            <DxGridDataColumn FieldName="@nameof(ReasonCategorieModel.isActive)" Caption="Hoạt động?" MinWidth="100" />
                            <DxGridDataColumn FieldName="@nameof(ReasonCategorieModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(ReasonCategorieModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(ReasonCategorieModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(ReasonCategorieModel.name)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(ReasonCategorieModel.name)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="60%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreate ? "Thêm mới lý do" : $"Cập nhật lý do")"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tên lý do" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <div class="row row-gap-2">
                        <div class="col-md-8 col-sm-12">
                            <DxTextBox @bind-Text="@ReasonCategorieUpdate.name" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <DxCheckBox CssClass="w-100 w1FontSize"
                                        SizeMode="@SizeMode.Small"
                                        @bind-Checked="@ReasonCategorieUpdate.isActive"
                                        LabelPosition="@LabelPosition.Right">
                                Hoạt động?
                            </DxCheckBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Loại lý do" Id="bacLuong" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxComboBox Data="@ListCboType"
                                @bind-Value="@ReasonCategorieUpdate.type"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Giá trị 1" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@ReasonCategorieUpdate.value" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Giá trị 2" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@ReasonCategorieUpdate.value1" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Giá trị 3" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@ReasonCategorieUpdate.value2" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />