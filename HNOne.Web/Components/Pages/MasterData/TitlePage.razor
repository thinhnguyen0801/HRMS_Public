@page "/chuc-danh"
@inherits Controllers.TitleController

<PageTitle>chức danh</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />
                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 150px); min-height: 350px">
                    <DxGrid Data="ListTitle" @ref="GridTitle"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedTitles"
                            KeyFieldName="@nameof(TitleModel.code)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.code)" Caption="Mã chức danh" MinWidth="150">
                                <CellDisplayTemplate>
                                    @{
                                        <a @onclick="@(() => OnOpenDialogHandler(EnumType.Update, (context.DataItem as TitleModel)))">@context.Value</a>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(TitleModel.name)" Caption="Tên chức danh" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.remark)" Caption="Ghi chú" MinWidth="210" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.isActive)" Caption="Active" MinWidth="210" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.branchId)" Caption="Chi nhánh" MinWidth="210" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.departmentId)" Caption="Phòng ban" MinWidth="210" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.createDate)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(TitleModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(TitleModel.code)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(TitleModel.code)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="65%" TextBtnAccept="Cập nhật"
         HeaderText="Thêm mới chức danh"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mã chức danh" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@TitleUpdate.code" ReadOnly="true" CssClass="w1FontSize"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tên chức danh" Id="bacLuong" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@TitleUpdate.name" CssClass="w1FontSize"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Trưởng phòng" Id="bacLuong" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.headId" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Chức vụ" Id="bacLuong" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.assistantManagerIds" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Số điện thoại" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.managerId" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Địa chỉ" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.headId" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex ">
                <W1Label Value="Active" Id="bacLuong" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.headId" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex ">
                <W1Label Value="Chi nhánh" Id="bacLuong" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.headId" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex ">
                <W1Label Value="Phòng ban" Id="bacLuong" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    @* <DxTextBox @bind-Text="@TitleUpdate.headId" CssClass="w1FontSize"></DxTextBox> *@
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />