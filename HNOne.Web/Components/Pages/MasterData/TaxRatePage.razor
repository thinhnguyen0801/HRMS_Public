@page "/danh-muc-muc-thue"
@inherits Controllers.TaxtRateController

<PageTitle>Danh mục mức thuế</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />

                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />
                            <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListTaxRate" @ref="GridTaxRate"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedItems"
                            KeyFieldName="@nameof(TaxRateModel.id)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="35px" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.taxBracket)" Caption="Bậc thuế" MinWidth="90" Width="100px">
                                <CellDisplayTemplate>
                                    @{
                                        if (IsAllowPut)
                                        {
                                            <a @onclick="@(() => OnOpenDialogHandler(EnumType.Update, (context.DataItem as TaxRateModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.branchName)" Caption="Chi nhánh" MinWidth="160" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.taxRate)" Caption="Thuế suất" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.minSalary)" Caption="Khung lương từ" MinWidth="130" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.maxSalary)" Caption="Khung lương đến" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.progressiveAmount)" Caption="Tiền tích lũy" MinWidth="110" DisplayFormat="@GlobalContants.FORMAT_CURRENCY" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(TaxRateModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(TaxRateModel.taxBracket)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(TaxRateModel.taxBracket)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="60%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreate ? "Thêm mới mức thuế" : $"Cập nhật mức thuế")"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Chi nhánh" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxComboBox Data="@ListCboBranch"
                                @bind-Value="@TaxRateUpdate.branchId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                Id="txtBranchId"
                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Bậc thuế" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxSpinEdit @bind-Value="@TaxRateUpdate.taxBracket" InputCssClass="text-end"
                                ShowSpinButtons="true" MinValue="0"
                                DisplayFormat="@GlobalContants.FORMAT_CURRENCY" Mask="@GlobalContants.FORMAT_CURRENCY" CssClass="w1FontSize" />
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Khung lương" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <div class="grid gap-1 row-gap-2">
                        <div class="g-col-md-6 g-col-sm-12 g-col-12">
                            <DxSpinEdit @bind-Value="@TaxRateUpdate.minSalary" InputCssClass="text-end"
                                        ShowSpinButtons="true" MinValue="0"
                                        DisplayFormat="@GlobalContants.FORMAT_CURRENCY" Mask="@GlobalContants.FORMAT_CURRENCY" CssClass="w1FontSize" />
                        </div>
                        <div class="g-col-md-6 g-col-sm-12 g-col-12">
                            <DxSpinEdit @bind-Value="@TaxRateUpdate.maxSalary" InputCssClass="text-end"
                                        ShowSpinButtons="true" MinValue="0"
                                        DisplayFormat="@GlobalContants.FORMAT_CURRENCY" Mask="@GlobalContants.FORMAT_CURRENCY" CssClass="w1FontSize" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Thuế suất" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxSpinEdit @bind-Value="@TaxRateUpdate.taxRate" InputCssClass="text-end"
                                ShowSpinButtons="true" MinValue="0"
                                DisplayFormat="@GlobalContants.FORMAT_CURRENCY" Mask="@GlobalContants.FORMAT_CURRENCY" CssClass="w1FontSize" />
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tiền tích lũy" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxSpinEdit @bind-Value="@TaxRateUpdate.progressiveAmount" InputCssClass="text-end"
                                ShowSpinButtons="true" MinValue="0"
                                DisplayFormat="@GlobalContants.FORMAT_CURRENCY" Mask="@GlobalContants.FORMAT_CURRENCY" CssClass="w1FontSize" />
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />