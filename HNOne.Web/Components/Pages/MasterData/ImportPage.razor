@page "/import-data"
@inherits Controllers.ImportController
@using System.Data;

<PageTitle>Import dữ liệu</PageTitle>
<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-md-4 col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Loại danh mục" Styles="width: 100px" IsRequired="true" />
                <div style="width: calc(100% - 100px)">
                    <DxComboBox Data="@ListCboCatagory"
                                @bind-Value="@ImportUpdate.code"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                ValueFieldName="@nameof(ComboboxModel.code)"
                                CssClass="w1FontSize">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Đường dẫn" Id="txtKiDanhGia" Styles="width: 100px" IsRequired="true" />
                <div style="width: calc(100% - 100px)">
                    <InputFile id="ref-upload" OnChange="@OnLoadFileHandler" />
                </div>
            </div>
        </div>
    </div>
    <div class="row row-gap-2 mt-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Tải dữ liệu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />

                            <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(() => SaveDataHandler())" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Dữ liệu Import" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Danh sách lỗi" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="min-height: 350px">
                                @if (dtData != null && dtData.Rows.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    @foreach (DataColumn dc in dtData.Columns)
                                                    {
                                                        <th style="min-width: 150px">@dc.Caption</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (DataRow dr in dtData.Rows)
                                                {
                                                    <tr>
                                                        @foreach (DataColumn dc in dtData.Columns)
                                                        {
                                                            <td>@dr[dc.ColumnName]</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                            break;
                        case 1:
                            <div style="min-height: 350px">
                                @if (dtData != null && dtData.Rows.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    @foreach (DataColumn dc in dtLogError.Columns)
                                                    {
                                                        <th style="min-width: 150px">@dc.Caption</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (DataRow dr in dtLogError.Rows)
                                                {
                                                    <tr>
                                                        @foreach (DataColumn dc in dtLogError.Columns)
                                                        {
                                                            <td>@dr[dc.ColumnName]</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div class="mb-3"></div>
<W1Confirm @ref="confirm" />