@page "/phe-duyet"
@inherits Controllers.ApprovalController

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">       
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />
                            <DxToolbarItem Text="Duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_APPROVAL}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@ApprovalHandler"
                                           Visible="@(IsAllowPut)" />
                            <DxToolbarItem Text="Từ chối" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REJECT}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@RejectHandler"
                                           Visible="@(IsAllowPut)" />
                           @*  <DxToolbarItem Text="Trả về" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_RETURN}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right"
                                           Visible="@(IsAllowPut)" /> *@
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Chờ duyệt" Id="tabPending" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Tất cả" Id="tabAll" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 185px); min-height: 350px">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <DxGrid Data="ListPending" @ref="GridPending"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    SelectionMode="@GridSelectionMode.Multiple"
                                    SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                    @bind-SelectedDataItems="@SelectedPendings"
                                    EditMode="GridEditMode.EditCell"
                                    EditModelSaving="@GridPendingEditSavingHandler"
                                    KeyFieldName="@nameof(ApprovalModel.id)"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridSelectionColumn Width="35px" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.objTypeName)" Caption="Loại chứng từ" MinWidth="140" DataRowEditorVisible="false" GroupIndex="0" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.voucherNo)" Caption="Mã chứng từ" MinWidth="130" DataRowEditorVisible="false">
                                        <CellDisplayTemplate>
                                            @{
                                                <a href="@($"{(context.DataItem as ApprovalModel)!.link}")">@context.Value</a>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.createDate)" Caption="Ngày giờ gửi" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.employeeCode)" Caption="Mã nhân viên" MinWidth="110" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.employeeName)" Caption="Tên nhân viên" MinWidth="150" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.remark)" Caption="Ghi chú chứng từ" MinWidth="150" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.approvalRemark)" Caption="Ghi chú phê duyệt" MinWidth="160">
                                        <HeaderCaptionTemplate>
                                            <span>Ghi chú phê duyệt <span style="color: red;">&nbsp;(*)</span></span>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.departmentName)" Caption="Phòng ban" MinWidth="150" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.branchName)" Caption="Chi nhánh" MinWidth="160" DataRowEditorVisible="false" />
                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                       FieldName="@nameof(ApprovalModel.voucherNo)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(ApprovalModel.voucherNo)" />
                                </TotalSummary>
                            </DxGrid>
                            break;
                        case 1:
                            <DxGrid Data="ListAll" @ref="GridAll"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    SelectionMode="@GridSelectionMode.Single"
                                    KeyFieldName="@nameof(ApprovalModel.id)"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.objTypeName)" Caption="Loại chứng từ" MinWidth="140" DataRowEditorVisible="false" GroupIndex="0"  />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.voucherNo)" Caption="Mã chứng từ" MinWidth="140" DataRowEditorVisible="false">
                                        <CellDisplayTemplate>
                                            @{
                                                <a href="@($"{(context.DataItem as ApprovalModel)!.link}")">@context.Value</a>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.statusName)" Caption="Tình trạng" MinWidth="140" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.createDate)" Caption="Ngày giờ tạo" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.employeeSignatureName)" Caption="Người duyệt" MinWidth="110" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.createDate)" Caption="Ngày giờ tạo" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.employeeCode)" Caption="Mã nhân viên" MinWidth="110" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.employeeName)" Caption="Tên nhân viên" MinWidth="150" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.remark)" Caption="Ghi chú chứng từ" MinWidth="150" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.approvalRemark)" Caption="Ghi chú phê duyệt" MinWidth="160" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.departmentName)" Caption="Phòng ban" MinWidth="150" DataRowEditorVisible="false" />
                                    <DxGridDataColumn FieldName="@nameof(ApprovalModel.branchName)" Caption="Tên chi nhánh" MinWidth="160" DataRowEditorVisible="false" />
                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                       FieldName="@nameof(ApprovalModel.voucherNo)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(ApprovalModel.voucherNo)" />
                                </TotalSummary>
                            </DxGrid>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<W1Confirm @ref="confirm" />
