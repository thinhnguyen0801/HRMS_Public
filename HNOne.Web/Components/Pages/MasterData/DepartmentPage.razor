@page "/phong-ban"
@inherits Controllers.DepartmentController

<PageTitle>Phòng ban</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />
                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListDepartment" @ref="GridDepartment"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedDepartments"
                            KeyFieldName="@nameof(DepartmentModel.code)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.code)" Caption="Mã phòng ban" MinWidth="140">
                                <CellDisplayTemplate>
                                    @{
                                        if(IsAllowPut)
                                        {
                                            <a @onclick="@(() => OnOpenDialogHandler(EnumType.Update, (context.DataItem as DepartmentModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.name)" Caption="Tên phòng ban" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.isActive)" Caption="Hoạt động?" MinWidth="100" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.branchName)" Caption="Chi nhánh" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.headName)" Caption="Trưởng phòng" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.assistantManagerName)" Caption="Phó phòng" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.remark)" Caption="Ghi chú" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(DepartmentModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(DepartmentModel.code)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(DepartmentModel.code)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="60%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreate ? "Thêm mới phòng ban" : $"Cập nhật phòng ban [{DepartmentUpdate.code}]")"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mã phòng ban" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <div class="row row-gap-2">
                        <div class="col-md-8 col-sm-12">
                            <DxTextBox @bind-Text="@DepartmentUpdate.code" ReadOnly="@(!IsCreate)" CssClass="w1FontSize" Id="txtCode"></DxTextBox>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <DxCheckBox CssClass="w-100 w1FontSize"
                                        SizeMode="@SizeMode.Small"
                                        @bind-Checked="@DepartmentUpdate.isActive"
                                        LabelPosition="@LabelPosition.Right">
                                Hoạt động?
                            </DxCheckBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tên phòng ban" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxTextBox @bind-Text="@DepartmentUpdate.name" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Chi nhánh" Styles="width: 110px" IsRequired="true" />
                <div style="width: calc(100% - 110px)">
                    <DxComboBox Data="@ListCboBranch"
                                @bind-Value="@DepartmentUpdate.branchId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                Id="txtBranchId"
                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Trưởng phòng" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <div class="grid gap-1 row-gap-2">
                        <div class="g-col-md-4 g-col-sm-12 g-col-12">
                            <DxTextBox @bind-Text="@DepartmentUpdate.headCode" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                        <div class="g-col-md-8 g-col-sm-12 g-col-12">
                            <DxTextBox @bind-Text="@DepartmentUpdate.headName" CssClass="w1FontSize" ReadOnly="true">
                                <Buttons>
                                    <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                    Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(DepartmentUpdate.headCode)))" />
                                </Buttons>
                            </DxTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Phó phòng" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <div class="grid gap-1 row-gap-2">
                        <div class="g-col-md-4 g-col-sm-12 g-col-12">
                            <DxTextBox @bind-Text="@DepartmentUpdate.assistantManagerCode" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                        <div class="g-col-md-8 g-col-sm-12 g-col-12">
                            <DxTextBox @bind-Text="@DepartmentUpdate.assistantManagerName" CssClass="w1FontSize" ReadOnly="true">
                                <Buttons>
                                    <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                    Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(DepartmentUpdate.assistantManagerCode)))" />
                                </Buttons>
                            </DxTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Ghi chú" Styles="width: 110px" />
                <div style="width: calc(100% - 110px)">
                    <DxMemo @bind-Text="@DepartmentUpdate.remark" CssClass="w1FontSize" BindValueMode="@BindValueMode.OnInput" Rows="2" />
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="55%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" />
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />