@page "/loai-hop-dong"
@inherits Controllers.ContractTypeController

<PageTitle>Loại hợp đồng</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />
                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />
                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />
                            <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListContractType" @ref="GridContractType"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedContractTypes"
                            KeyFieldName="@nameof(ContractTypeModel.code)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.code)" Caption="Mã loại hợp đồng" MinWidth="150" >
                                <CellDisplayTemplate>
                                    @{
                                        if(IsAllowPut)
                                        {
                                            <a @onclick="@(()=> OnOpenDialogHandler(EnumType.Update, (context.DataItem as ContractTypeModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.name)" Caption="Tên loại hợp đồng" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.branchName)" Caption="Chi nhánh" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.isActive)" Caption="Hoạt động?" MinWidth="100" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.statusName)" Caption="Trạng thái n/viên" MinWidth="110" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.duration)" Caption="Thời hạn" MinWidth="110" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.isIndefiniteDuration)" Caption="Không xác định?" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.numberOfDaysReduced)" Caption="Số ngày giảm" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.remark)" Caption="Ghi chú" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(ContractTypeModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(ContractTypeModel.code)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(ContractTypeModel.code)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="65%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreate ? "Thêm mới loại hợp đồng" : $"Cập nhật loại hợp đồng [{ContractTypeUpdate.code}]")"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2 w1FontSize">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mã loại hợp đồng" Id="bacLuong" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <div class="row row-gap-2">
                        <div class="col-md-8 col-sm-12">
                            <DxTextBox @bind-Text="@ContractTypeUpdate.code" CssClass="w1FontSize" ReadOnly="@(!IsCreate)" Id="txtCode"></DxTextBox>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <DxCheckBox CssClass="w-100 w1FontSize"
                                        SizeMode="@SizeMode.Small"
                                        @bind-Checked="@ContractTypeUpdate.isActive"
                                        LabelPosition="@LabelPosition.Right">
                                Hoạt động?
                            </DxCheckBox>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tên loại hợp đồng" Id="bacLuong" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <DxTextBox @bind-Text="@ContractTypeUpdate.name" CssClass="w1FontSize" Id="txtName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Chi nhánh"Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <DxComboBox Data="@ListCboBranch"
                                @bind-Value="@ContractTypeUpdate.branchId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                Id="txtBranchId"
                                CssClass="w1FontSize"
                                ValueFieldName="@nameof(ComboboxModel.id)">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Trạng thái nhân viên" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <DxComboBox Data="@ListCboStatus"
                                @bind-Value="@ContractTypeUpdate.statusCode"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                Id="txtStatusCode"
                                CssClass="w1FontSize"
                                ValueFieldName="@nameof(ComboboxModel.code)">
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Thời hạng (tháng)" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <div class="row row-gap-2">
                        <div class="col-md-8 col-sm-12">
                            <DxSpinEdit @bind-Value="@ContractTypeUpdate.duration" MinValue="0.0" Increment="1"
                                        InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <DxCheckBox CssClass="w-100 w1FontSize"
                                        SizeMode="@SizeMode.Small"
                                        @bind-Checked="@ContractTypeUpdate.isIndefiniteDuration"
                                        LabelPosition="@LabelPosition.Right">
                                Không xác định?
                            </DxCheckBox>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Số ngày giảm trừ" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <div class="row row-gap-2">
                        <div class="col-md-8 col-sm-12">
                            <DxSpinEdit @bind-Value="@ContractTypeUpdate.numberOfDaysReduced" MinValue="0" Increment="1"
                                        InputCssClass="text-end" ShowSpinButtons="true" CssClass="w1FontSize" />
                        </div>
                        <div class="col-md-4 col-sm-12"></div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Ghi chú" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxMemo @bind-Text="@ContractTypeUpdate.remark" CssClass="w1FontSize" BindValueMode="@BindValueMode.OnInput" Rows="2" />
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />