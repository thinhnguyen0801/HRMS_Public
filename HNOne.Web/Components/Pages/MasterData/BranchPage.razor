@page "/chi-nhanh"
@inherits Controllers.BranchController

<PageTitle>Chi nhánh</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />
                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListBranch" @ref="GridBranch"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedBranchs"
                            KeyFieldName="@nameof(BranchModel.branchCode)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(BranchModel.branchCode)" Caption="Mã chi nhánh" MinWidth="150">
                                <CellDisplayTemplate>
                                    @{
                                        if(IsAllowPut)
                                        {
                                            <a @onclick="@(()=> OnOpenDialogHandler(EnumType.Update, (context.DataItem as BranchModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(BranchModel.branchName)" Caption="Tên chi nhánh" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(BranchModel.phoneNumber)" Caption="Số điện thoại" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(BranchModel.address)" Caption="Địa chỉ" MinWidth="210" />
                            <DxGridDataColumn FieldName="@nameof(BranchModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(BranchModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(BranchModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(BranchModel.branchCode)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(BranchModel.branchCode)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="65%" TextBtnAccept="Cập nhật"
         HeaderText="@(IsCreate ? "Thêm mới chi nhánh" : $"Cập nhật chi nhánh [{BranchUpdate.branchCode}]")"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Mã chi nhánh" Id="branchCode" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <DxTextBox @bind-Text="@BranchUpdate.branchCode" ReadOnly="@(!IsCreate)" CssClass="w1FontSize" Id="branchCode"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tên chi nhánh" Id="bacLuong" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <DxTextBox @bind-Text="@BranchUpdate.branchName" CssClass="w1FontSize" Id="branchName"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Số điện thoại" Id="bacLuong" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxTextBox @bind-Text="@BranchUpdate.phoneNumber" CssClass="w1FontSize"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Địa chỉ" Id="bacLuong" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxTextBox @bind-Text="@BranchUpdate.address" CssClass="w1FontSize"></DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Mật khẩu mặc định" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px); position: relative;">
                    <DxTextBox @bind-Text="@BranchUpdate.defaultPassword" Id="txtPasswordDefault" autocomplete="off"
                               SizeMode="SizeMode.Medium" Password="@(!IsShowPassword)">
                        <Buttons>
                            <DxEditorButton IconCssClass="@(IsShowPassword ? "fa-regular fa-eye" : "fa-regular fa-eye-slash")"
                                            Tooltip="Hiển thị mật khẩu" Click="@ShowPasswordHandler" />
                        </Buttons>
                    </DxTextBox>
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />