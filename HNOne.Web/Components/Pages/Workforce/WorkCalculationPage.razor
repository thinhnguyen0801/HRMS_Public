                                                <HeaderCaptionTemplate>
                                                    <span title="Nghỉ lễ">NL</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.nPN)" Caption="Nghỉ phép năm" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Nghỉ phép năm">PN</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.nCD)" Caption="Nghỉ chế độ" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Nghỉ chế độ">CĐ</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.nPKL)" Caption="Nghỉ phép không lương" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Nghỉ phép không lương">PKL</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.nB)" Caption="Nghỉ bù" Width="50px" MinWidth="40"
