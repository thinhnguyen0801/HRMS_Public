                                                <HeaderCaptionTemplate>
                                                    <span title="Tổng giờ thiếu">TGT</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.gCTC)" Caption="Giờ công tiêu chuẩn của 1 ngày" Width="70px" MinWidth="65"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Giờ công tiêu chuẩn của 1 ngày">Giờ công</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.tGTC)" Caption="Tổng số giờ tăng ca tháng này" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Tổng số giờ tăng ca tháng này">TGTC</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.sGTCTC)" Caption="Số giờ tăng ca tiêu chuẩn trong tháng" Width="60px" MinWidth="50"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Số giờ tăng ca tiêu chuẩn trong tháng">SGTCTC</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.sGTCTT)" Caption="Số giờ tăng ca dư của tháng trước" Width="60px" MinWidth="50"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Số giờ tăng ca dư của tháng trước">SGTCTT</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.sGTCKT)" Caption="Số giờ tăng ca được chuyển sang tháng tiếp theo" Width="60px" MinWidth="50"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Số giờ tăng ca được chuyển sang tháng tiếp theo">SGTCKT</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.n01)" Caption="@($"01/{SearchUpdate.month}")" MinWidth="50"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                                <CellDisplayTemplate>
                                                    @{
                                                        @((MarkupString)$"{context.Value}")
                                                    }
                                                </CellDisplayTemplate>
