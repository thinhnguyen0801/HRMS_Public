@page "/tinh-cong-nhan-vien"
@inherits Controllers.WorkCalculationController
<PageTitle>Tính công nhân viên</PageTitle>

<div class="h-content-filter">
    <div class="grid gap-1 row-gap-2">
        <div class="@(IsShowFilter ? "g-col-md-4 g-col-sm-12 g-col-12" : "d-none")">
            <div class="card w1FontSize">
                <div class="card-header py-1 px-2">
                    <h4 class="mb-0 w1FontSize">Thông tin tìm kiếm</h4>
                </div>
                <div class="card-body p-1">
                    <div class="row row-gap-2">
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Chi nhánh" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxComboBox Data="@ListCboBranch"
                                                @bind-Value="@SearchUpdate.branchId"
                                                FilteringMode="DataGridFilteringMode.Contains"
                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                Id="txtBranchId"
                                                ReadOnly="true"
                                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                    </DxComboBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Tháng/năm" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <div class="grid gap-1 row-gap-2">
                                        <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                            <DxComboBox Data="@ListCboMonth"
                                                        @bind-Value="@SearchUpdate.month"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        TextFieldName="@nameof(ComboboxModel.name)"
                                                        ValueFieldName="@nameof(ComboboxModel.id)"
                                                        CssClass="w1FontSize">
                                            </DxComboBox>
                                        </div>
                                        <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                            <DxComboBox Data="@ListCboYear"
                                                        @bind-Value="@SearchUpdate.year"
                                                        FilteringMode="DataGridFilteringMode.Contains"
                                                        TextFieldName="@nameof(ComboboxModel.name)"
                                                        ValueFieldName="@nameof(ComboboxModel.id)"
                                                        CssClass="w1FontSize">
                                            </DxComboBox>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Phòng ban" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxTagBox Data="@ListCboDepartment"
                                              @bind-Values="@ListDepartmentSelected" CssClass="w1FontSize"
                                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                              TextFieldName="@nameof(ComboboxModel.name)">
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                    </DxTagBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Trạng thái" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxTagBox Data="@ListCboStatus"
                                              @bind-Values="@ListCboStatusSelected" CssClass="w1FontSize"
                                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                              TextFieldName="@nameof(ComboboxModel.name)">
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                    </DxTagBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div style="height: calc(100vh - 305px); min-height: 250px">
                                <DxGrid Data="ListEmpSearch" @ref="GridEmpSearch"
                                        ShowFilterRow="true"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="true"
                                        PageSize="@GlobalContants.PageSize"
                                        PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                        PageSizeSelectorAllRowsItemVisible="true"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        FocusedRowEnabled="true"
                                        SelectionMode="@GridSelectionMode.Multiple"
                                        SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                        AutoExpandAllGroupRows="true"
                                        AllowSelectRowByClick="true"
                                        @bind-SelectedDataItems="@SelectedDataEmployees"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right" Tooltip="Làm mới"
                                                               IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                                               Click="@ReloadEmployeeHandler" />
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridSelectionColumn Width="35px" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.code)" Caption="Mã nhân viên" MinWidth="100" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.name)" Caption="Họ tên" MinWidth="150" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.departmentName)" Caption="Phòng ban" MinWidth="120" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.titleName)" Caption="Chức danh" MinWidth="140" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.statusName)" Caption="Trạng thái" MinWidth="150" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="@(IsShowFilter ? "g-col-md-8 g-col-sm-12 g-col-12" : "g-col-md-12 g-col-sm-12 g-col-12")">
            <div class="row row-gap-2">
                <div class="col-12">
                    <div class="card w1FontSize">
                        <div class="card-header p-1 position-relative">
                            <div class="position-absolute" style="z-index: 10">
                                <i class="@(IsShowFilter ? $"{IconClassConstants.ICON_FILTER_CLEAR}" : $"{IconClassConstants.ICON_FILTER}") @IconClassConstants.FONT_SIZE_ICON"
                                    title="@(IsShowFilter ? "Thu gọn vùng tìm kiếm" : "Mở rộng vùng tìm kiếm")" @onclick="@ShowFilterHandler"/>
                            </div>
                            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                                <Items>
                                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />

                                    <DxToolbarItem Text="Tính công" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_CALCULATOR}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@WorkCalculateHandler" Visible="@(IsAllowPost)" />

                                    <DxToolbarItem Text="Lưu công tháng" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler" Visible="@(IsAllowPut)"  />

                                    <DxToolbarItem Text="Khóa kỳ" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_TABLE_LOCK}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@LockTimeSheetEmployeeHandler" Visible="@(IsAllowPutAccept)" />

                                    <DxToolbarItem Text="Mở kỳ" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_TABLE_UNLOCK}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@UnlockTimeSheetEmployeeHandler" Visible="@(IsAllowPutAccept)" />

                                    <DxToolbarItem Text="Kết xuất" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_EXPORT_EXCEL}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@(()=> ExportExcelHandler())" />

                                    @* <DxToolbarItem Text="Tính công" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_CALCULATOR}")" CssClass="w1FontSize"
                                    Alignment="@ToolbarItemAlignment.Right" /> *@
                                </Items>
                            </DxToolbar>
                        </div>
                        <div class="card-body p-1" style="height: calc(100vh - 165px); min-height: 450px">
