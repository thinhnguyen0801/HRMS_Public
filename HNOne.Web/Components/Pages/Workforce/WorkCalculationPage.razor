                                        <CellDisplayTemplate>
                                            @{
                                                @((MarkupString)$"{context.Value}")
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.n29)" Caption="@($"29/{SearchUpdate.month}")" MinWidth="50"
                                                      TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" Visible="@(MaxDaysInMonth > 28)">
                                        <CellDisplayTemplate>
                                            @{
                                                @((MarkupString)$"{context.Value}")
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.n30)" Caption="@($"30/{SearchUpdate.month}")" MinWidth="50"
                                                      TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" Visible="@(MaxDaysInMonth > 29)">
                                        <CellDisplayTemplate>
                                            @{
                                                @((MarkupString)$"{context.Value}")
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.n31)" Caption="@($"31/{SearchUpdate.month}")" MinWidth="50"
                                                      TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" Visible="@(MaxDaysInMonth > 30)">
                                        <CellDisplayTemplate>
                                            @{
                                                @((MarkupString)$"{context.Value}")
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                       FieldName="@nameof(ShiftAssignmentModel.employeeCode)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(ShiftAssignmentModel.employeeCode)" />
                                </TotalSummary>
                            </DxGrid>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

