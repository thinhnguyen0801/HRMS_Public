                                                <HeaderCaptionTemplate>
                                                    <span title="Công thực tế">CTT</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.nL)" Caption="Nghỉ lễ" Width="50px" MinWidth="40"
