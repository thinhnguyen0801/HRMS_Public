                                            <DxGridSelectionColumn Width="45px" FixedPosition="@GridColumnFixedPosition.Left" />
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.employeeCode)" Caption="Mã nhân viên" Width="110px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left">
