                                                <HeaderCaptionTemplate>
                                                    <span title="Công tính phụ cấp">CTPC</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.tGDLTVS)" Caption="+/-" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Thời gian làm trễ về sớm (Phút)">+/-</span>
                                                </HeaderCaptionTemplate>
                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.sLDLTVS)" Caption="Số lần đi trễ về sớm" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Số lần đi trễ về sớm">SLT/S</span>
