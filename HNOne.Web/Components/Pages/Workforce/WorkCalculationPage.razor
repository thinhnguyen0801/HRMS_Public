                                            </DxGridDataColumn>
                                            <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.nNV)" Caption="Nghỉ ngừng việc" Width="50px" MinWidth="40"
                                                              TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DisplayFormat="@GlobalContants.FORMAT_NUMBER">
                                                <HeaderCaptionTemplate>
                                                    <span title="Nghỉ ngừng việc">NNV</span>
                                                </HeaderCaptionTemplate>
