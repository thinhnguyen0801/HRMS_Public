<W1Popup @bind-IsOpenModal="@IsShowDetail" Width="85%"
         TextBtnAccept="Chọn"
         IsShowFooter="false"
         HeaderText="@HeaderTextDetail">
    <div style="height: 400px; min-height: 350px">
        <DxGrid Data="ListTimesheetDetail" @ref="GridTimesheetDetail"
                ShowFilterRow="true"
                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                PagerPosition="GridPagerPosition.Bottom"
                PageSizeSelectorVisible="false"
                PageSize="@GlobalContants.PageSize"
                PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                PageSizeSelectorAllRowsItemVisible="false"
                PagerSwitchToInputBoxButtonCount="10"
                PagerVisibleNumericButtonCount="10"
                TextWrapEnabled="false"
                FocusedRowEnabled="true"
                SelectionMode="@GridSelectionMode.Single"
                AutoExpandAllGroupRows="true"
                AllowSelectRowByClick="true"
                CssClass="h-full">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.employeeCode)" Caption="Mã nhân viên" Width="110px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.employeeName)" Caption="Họ tên" Width="135px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.titleName)" Caption="Chức danh" Width="125px" MinWidth="100" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.shiftCode)" Caption="Ca" Width="70px" MinWidth="70" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.symbol)" Caption="Ký hiệu" Width="90px" MinWidth="70" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <CellDisplayTemplate>
                        @{
                            <span style="padding: 2px;background-color: @($"{(context.DataItem as ShiftAssignmentModel)!.bgColor}")">@context.Value</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.voucherNo)" Caption="Chứng từ liên quan" Width="130px" MinWidth="120"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <CellDisplayTemplate>
                        @{
                            <a href="@($"{(context.DataItem as ShiftAssignmentModel)!.link}")">@context.Value</a>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.workingDate)" Caption="Ngày làm việc" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_DATE" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center"  />
                
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startDate)" Caption="Giờ bắt đầu" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ</div>
                        <div>Bắt đầu</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endDate)" Caption="Giờ kết thúc" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ</div>
                        <div>Kết thúc</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startBreakTime)" Caption="Giờ nghỉ b/đ" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ</div>
                        <div>Bắt đầu</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endBreakTime)" Caption="Giờ nghỉ k/t" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ</div>
                        <div>Kết thúc</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.isDayOff)" Caption="Ngày nghỉ" Width="60px" MinWidth="60"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Ngày</div>
                        <div>Nghỉ?</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.totalWorkingHours)" Caption="Số giờ làm" Width="70px" MinWidth="70"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Số giờ</div>
                        <div>Làm</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startDateActual)" Caption="Giờ b/đ thực tế" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ b/đ</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endDateActual)" Caption="Giờ k/t thực tế" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ k/t</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startDateConfirmActual)" Caption="Giờ b/đ xác nhận" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ b/đ</div>
                        <div>Xác nhận</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endDateConfirmActual)" Caption="Giờ k/t xác nhận" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ k/t</div>
                        <div>Xác nhận</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startBreakTimeActual)" Caption="Giờ nghỉ b/đ thực tế" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ b/đ</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endBreakTimeActual)" Caption="Giờ nghỉ k/t thực tế" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ k/t</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>

                <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.totalWorkingHoursActual)" Caption="Số giờ làm thực tế" Width="100px" MinWidth="90"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Số giờ làm</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.sGT)" Caption="Số giờ thiếu" Width="100px" MinWidth="90"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                    <HeaderCaptionTemplate>
                        <div>Số giờ</div>
                        <div>Thiếu</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    </div>
</W1Popup>

