@page "/dang-ky-doi-ca"
@inherits Controllers.ShiftChangeRequestController
<PageTitle>Đăng kí đổi ca</PageTitle>

<div class="h-content-filter">
    @if(!IsReadonlyControl)
    {
        <div class="card p-1">
            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                <Items>

                    <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler" />

                    <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(()=> SubmitForApprovalHandler())"
                                   Visible="@(ShiftRequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD)" />

                    <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" />

                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" />
                </Items>
            </DxToolbar>
        </div>
    }
    
    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin chung</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@ShiftRequestDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@ShiftRequestDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nhân viên" Id="txtKiDanhGia" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ShiftRequestDocument.employeeCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ShiftRequestDocument.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên" 
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(ShiftRequestDocument.employeeCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phòng ban" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboDepartment"
                                                            @bind-Value="@ShiftRequestDocument.departmentId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                            Id="departmentId" ReadOnly="@IsReadonlyControl"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ShiftRequestDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeSignatureId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ShiftRequestDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên" 
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(ShiftRequestDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@ShiftRequestDocument.dateOfSigning"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Ca thay đổi" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboShift"
                                                            @bind-Value="@ShiftRequestDocument.shiftCode2"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="@IsReadonlyControl"
                                                            CssClass="w1FontSize" Id="shiftCode2">
                                                    <Columns>
                                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Width="120px" Caption="Mã" />
                                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                                    </Columns>
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Từ ngày/đến ngày" Id="ngayBatDau" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit Date="@ShiftRequestDocument.fromDate"
                                                                    DateChanged="@((DateTime? fromDate)=>DateEditValueChangedHandler(fromDate, controlID: nameof(ShiftRequestDocument.fromDate)))"
                                                                    CssClass="w1FontSize" Id="startDate" ReadOnly="@IsReadonlyControl"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit Date="@ShiftRequestDocument.toDate"
                                                                    DateChanged="@((DateTime? toDate)=>DateEditValueChangedHandler(toDate, controlID: nameof(ShiftRequestDocument.toDate)))"
                                                                    CssClass="w1FontSize" Id="endDate" ReadOnly="@IsReadonlyControl"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Lý do đổi ca" Styles="width: 120px" IsRequired="true"/>
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@ShiftRequestDocument.reason" BindValueMode="@BindValueMode.OnInput" Rows="1" 
                                                        InputId="txtghiChu" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Danh sách đổi ca" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListShiftChange" @ref="GridShiftChange"
                                        ShowFilterRow="false"
                                        PageSize="500"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldNames="@(new [] {nameof(ShiftChange1Model.dateChange),nameof(ShiftChange1Model.id)})"
                                        ValidationEnabled="true"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="@GridLeaveDateEditSavingHandler"
                                        CustomizeElement="@GridLeaveDateCustomizeElement"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Single"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_REFRESH" BeginGroup="true" Visible="@(!IsReadonlyControl)"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Lấy thông tin ngày đổi ca" Click="@CreateShiftChangeDateHandler" />
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(ShiftChange1Model.dateChange)" Caption="Ngày đổi ca" MinWidth="140" Width="140px"
                                                          DisplayFormat="@GlobalContants.FORMAT_DATE" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(ShiftChange1Model.shiftCode1)" Caption="Ca mặc định" Width="180px" MinWidth="150" 
                                                          DataRowEditorVisible="false" />

                                        <DxGridDataColumn FieldName="@nameof(ShiftChange1Model.shiftCode2)" Caption="Ca thay đổi" Width="210px" MinWidth="210">
                                            <HeaderCaptionTemplate>
                                                <span>Ca thay đổi <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                            <EditSettings>
                                                <DxComboBoxSettings Data="@ListCboShift"
                                                                    FilteringMode="DataGridFilteringMode.Contains"
                                                                    TextFieldName="@nameof(ComboboxModel.code)"
                                                                    ValueFieldName="@nameof(ComboboxModel.code)"
                                                                    CssClass="w1FontSize">
                                                    <Columns>
                                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Width="120px" Caption="Mã" />
                                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                                    </Columns>
                                                </DxComboBoxSettings>
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(OvertimeRequest1Model.symbol)" Caption="Ký hiệu" Width="100px" MinWidth="90" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(ShiftChange1Model.remark)" Caption="Ghi chú" MinWidth="170">
                                            <HeaderCaptionTemplate>
                                                <span>Ghi chú <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                    </Columns>
                                </DxGrid>
                            </div>
                            break;
                        case 1:
                            <div style="height: 350px; min-height: 350px; line-height: 20px" class="w1FontSize px-2 py-1 text-truncate">
                                @((MarkupString)$"{VoucherHistory}")
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>

</div>



<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="70%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" />
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />