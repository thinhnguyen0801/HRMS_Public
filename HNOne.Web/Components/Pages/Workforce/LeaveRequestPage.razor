@page "/de-nghi-nghi-phep"
@inherits Controllers.LeaveRequestController

<div class="h-content-filter">
    <div class="card p-1">
        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
            <Items>

                <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" />

                <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" />

                <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" />

                <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                               Alignment="@ToolbarItemAlignment.Right" />
            </Items>
        </DxToolbar>
    </div>

    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin chung</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@LeaveRequestDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@LeaveRequestDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nhân viên" Id="txtKiDanhGia" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeCode" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(LeaveRequestDocument.employeeCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phòng ban" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboDepartment"
                                                            @bind-Value="@LeaveRequestDocument.departmentId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                            Id="departmentId"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(LeaveRequestDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@LeaveRequestDocument.fromDate"
                                                            CssClass="w1FontSize" Id="startDate"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Lý do nghỉ" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboReason"
                                                            @bind-Value="@LeaveRequestDocument.reasonId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Từ ngày/đến ngày" Id="ngayBatDau" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit @bind-Date="@LeaveRequestDocument.fromDate"
                                                                    CssClass="w1FontSize" Id="startDate"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit @bind-Date="@LeaveRequestDocument.toDate" CssClass="w1FontSize" Id="endDate"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ghi chú" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@LeaveRequestDocument.remark" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtghiChu" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-lg mt-1" style="padding: 5px" id="section-accordion-12">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-12">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-12" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin phép năm</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-12" class="accordion-collapse collapse show" data-bs-parent="#accordion-12">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-4 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phép trong năm" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxSpinEdit @bind-Value="@LeaveRequestDocument.numOfLeave" ReadOnly="true"
                                                            InputCssClass="text-end" ShowSpinButtons="false" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phép năm củ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxSpinEdit @bind-Value="@LeaveRequestDocument.numOfLeaveOld" ReadOnly="true"
                                                            InputCssClass="text-end" ShowSpinButtons="false" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phép được cộng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxSpinEdit @bind-Value="@LeaveRequestDocument.numOfLeave" ReadOnly="true"
                                                            InputCssClass="text-end" ShowSpinButtons="false" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Tổng phép năm" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxSpinEdit @bind-Value="@LeaveRequestDocument.numOfLeave" ReadOnly="true"
                                                            InputCssClass="text-end" ShowSpinButtons="false" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phép năm đã dùng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxSpinEdit @bind-Value="@LeaveRequestDocument.numOfLeave" ReadOnly="true"
                                                            InputCssClass="text-end" ShowSpinButtons="false" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phép năm còn lại" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxSpinEdit @bind-Value="@LeaveRequestDocument.numOfLeave" ReadOnly="true"
                                                            InputCssClass="text-end" ShowSpinButtons="false" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Danh sách ngày nghỉ" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListOfVacationDays" @ref="GridOfVacationDays"
                                        ShowFilterRow="false"
                                        PageSize="500"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldName="@nameof(SalaryConfigurationModel.id)"
                                        ValidationEnabled="true"
                                        EditMode="GridEditMode.EditCell"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Single"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_REFRESH" BeginGroup="true" 
                                                    Alignment="@ToolbarItemAlignment.Right"  Tooltip="Lấy thông tin ngày nghỉ"/>
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.dateOff)" Caption="Ngày nghỉ phép" MinWidth="150" DataRowEditorVisible="false" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.isMorningBreak)" Caption="Nghỉ buổi sáng?" MinWidth="110" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.isAfternoonBreak)" Caption="Nghỉ buổi chiều?" MinWidth="120" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.remark)" Caption="Ghi chú" MinWidth="170" />
                                    </Columns>
                                </DxGrid>
                            </div>
                            break;
                        case 1:
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="70%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" />
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />