@page "/xac-nhan-gio-cong"
@inherits Controllers.ConfirmWorkingDayController
<PageTitle>Xác nhận ngày công</PageTitle>

<div class="h-content-filter">
    @if (!IsReadonlyControl)
    {
        <div class="card p-1">
            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                <Items>

                    <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler"
                                   Visible="@((pActionType == nameof(EnumType.Add) && IsAllowPost) || (pActionType != nameof(EnumType.Add) && IsAllowPut))" />

                    <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(()=> SubmitForApprovalHandler())"
                                   Visible="@(ConfirmRequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                    <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(() => CancelDocumentHandler())"
                                   Visible="@(pActionType != nameof(EnumType.Add) && ConfirmRequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshDataHandler" />
                </Items>
            </DxToolbar>
        </div>
    }

    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin chung</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@ConfirmRequestDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@ConfirmRequestDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tháng công" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@ConfirmRequestDocument.workingDate"
                                                            CssClass="w1FontSize" Id="startDate" ReadOnly="@IsReadonlyControl"
                                                            Mask="@GlobalContants.FORMAT_MONTH" Format="@GlobalContants.FORMAT_MONTH"
                                                            DisplayFormat="@GlobalContants.FORMAT_MONTH" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@ConfirmRequestDocument.createDate"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nhân viên" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ConfirmRequestDocument.employeeCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ConfirmRequestDocument.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên" 
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(ConfirmRequestDocument.employeeCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phòng ban" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboDepartment"
                                                            @bind-Value="@ConfirmRequestDocument.departmentId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                            Id="departmentId" ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ConfirmRequestDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeSignatureId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@ConfirmRequestDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên" 
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(ConfirmRequestDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@ConfirmRequestDocument.dateOfSigning"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Lý do" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@ConfirmRequestDocument.remark" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtRemark" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Danh sách ngày nghỉ" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListOfVacationDays" @ref="GridOfVacationDays"
                                        ShowFilterRow="false"
                                        PageSize="500"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldNames="@(new [] {nameof(ConfirmWorkingDay1Model.workingDate),nameof(ConfirmWorkingDay1Model.id)})"
                                        ValidationEnabled="true"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="@GridLeaveDateEditSavingHandler"
                                        CustomizeElement="@GridLeaveDateCustomizeElement"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Multiple"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_FIND" BeginGroup="true" 
                                                               Visible="@(!IsReadonlyControl)"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Lấy thông tin ngày xác nhận công"
                                                               Click="@(async () => await OpenPopupHandler(nameof(ListTimesheetDetail)))"/>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_DELETE" BeginGroup="true"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Xóa nhân viên"
                                                               Visible="@(!IsReadonlyControl)"
                                                               Click="@DeleteDataHandler" />
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridSelectionColumn Width="35px" />
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.workingDate)" Caption="Ngày đăng ký" MinWidth="100" Width="110px"
                                                          DisplayFormat="@GlobalContants.FORMAT_DATE" DataRowEditorVisible="false" />

                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.fromTime)" Caption="Giờ vào" Width="100px" MinWidth="100"
                                                          DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <EditSettings>
                                                <DxTimeEditSettings CssClass="w1FontSize" Mask="@GlobalContants.FORMAT_TIME" Format="@GlobalContants.FORMAT_TIME"
                                                                    DisplayFormat="@GlobalContants.FORMAT_TIME" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.toTime)" Caption="Giờ ra" Width="100px" MinWidth="100"
                                                          DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <EditSettings>
                                                <DxTimeEditSettings CssClass="w1FontSize" Mask="@GlobalContants.FORMAT_TIME" Format="@GlobalContants.FORMAT_TIME"
                                                                    DisplayFormat="@GlobalContants.FORMAT_TIME" />
                                            </EditSettings>
                                        </DxGridDataColumn>

                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.remark)" Caption="Ghi chú" MinWidth="150" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Ghi chú <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.shiftCode)" Caption="Ca" Width="70px" MinWidth="60" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.startTime)" Caption="Giờ " Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                                            <HeaderCaptionTemplate>
                                                <div>Giờ</div>
                                                <div>Bắt đầu</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.endTime)" Caption="Giờ kết thúc" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                                          TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false" >
                                            <HeaderCaptionTemplate>
                                                <div>Giờ</div>
                                                <div>Kết thúc</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.startBreakTime)" Caption="Giờ nghỉ b/đ" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                                            <HeaderCaptionTemplate>
                                                <div>Giờ nghỉ</div>
                                                <div>Bắt đầu</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.endBreakTime)" Caption="Giờ nghỉ k/t" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false" >
                                            <HeaderCaptionTemplate>
                                                <div>Giờ nghỉ</div>
                                                <div>Kết thúc</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.totalWorkingHours)" Caption="Số giờ làm" Width="70px" MinWidth="70"
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false" >
                                            <HeaderCaptionTemplate>
                                                <div>Số giờ</div>
                                                <div>Làm</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.startTimeActual)" Caption="Giờ b/đ thực tế" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                                            <HeaderCaptionTemplate>
                                                <div>Giờ b/đ</div>
                                                <div>Thực tế</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.endTimeActual)" Caption="Giờ k/t thực tế" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                                            <HeaderCaptionTemplate>
                                                <div>Giờ k/t</div>
                                                <div>Thực tế</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.startBreakTimeActual)" Caption="Giờ nghỉ b/đ thực tế" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                                            <HeaderCaptionTemplate>
                                                <div>Giờ nghỉ b/đ</div>
                                                <div>Thực tế</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.endBreakTimeActual)" Caption="Giờ nghỉ k/t thực tế" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false" >
                                            <HeaderCaptionTemplate>
                                                <div>Giờ nghỉ k/t</div>
                                                <div>Thực tế</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.totalWorkingHoursActual)" Caption="Số giờ làm thực tế" Width="100px" MinWidth="90"
                                                          TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false" >
                                            <HeaderCaptionTemplate>
                                                <div>Số giờ làm</div>
                                                <div>Thực tế</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.totalMissingHours)" Caption="Số giờ thiếu" Width="100px" MinWidth="90" 
                                            TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                                            <HeaderCaptionTemplate>
                                                <div>Số giờ</div>
                                                <div>Thiếu</div>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                    </Columns>
                                </DxGrid>
                            </div>
                            break;
                        case 1:
                            <div style="height: 350px; min-height: 350px; line-height: 20px" class="w1FontSize px-2 py-1 text-truncate">
                                @((MarkupString)$"{VoucherHistory}")
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialogWDayMissing" Width="85%"
         HandleClickAccept="@(()=> SelectWorkingDayMissing())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách ngày công thiếu">
    <div style="height: 400px; min-height: 350px">
        <DxGrid Data="ListTimesheetDetail" @ref="GridTimesheetDetail"
                ShowFilterRow="true"
                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                PagerPosition="GridPagerPosition.Bottom"
                PageSizeSelectorVisible="false"
                PageSize="@GlobalContants.PageSize"
                PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                PageSizeSelectorAllRowsItemVisible="false"
                PagerSwitchToInputBoxButtonCount="10"
                PagerVisibleNumericButtonCount="10"
                TextWrapEnabled="false"
                FocusedRowEnabled="true"
                SelectionMode="@GridSelectionMode.Multiple"
                @bind-SelectedDataItems="@ListTimesheetDetails"
                AutoExpandAllGroupRows="true"
                AllowSelectRowByClick="true"
                CssClass="h-full">
            <Columns>
                <DxGridSelectionColumn Width="55px" FixedPosition="@GridColumnFixedPosition.Left" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.employeeCode)" Caption="Mã nhân viên" Width="110px" MinWidth="100" FixedPosition="@GridColumnFixedPosition.Left" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.shiftCode)" Caption="Ca làm việc" Width="90px" MinWidth="70" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.symbol)" Caption="Ký hiệu" Width="90px" MinWidth="70" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.workingDate)" Caption="Ngày làm việc" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_DATE" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center"  />
                
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startDate)" Caption="Giờ bắt đầu" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ</div>
                        <div>Bắt đầu</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endDate)" Caption="Giờ kết thúc" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ</div>
                        <div>Kết thúc</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startBreakTime)" Caption="Giờ nghỉ b/đ" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ</div>
                        <div>Bắt đầu</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endBreakTime)" Caption="Giờ nghỉ k/t" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ</div>
                        <div>Kết thúc</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.isDayOff)" Caption="Ngày nghỉ?" Width="80px" MinWidth="90" />
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.totalWorkingHours)" Caption="Số giờ làm" Width="70px" MinWidth="70"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Số giờ</div>
                        <div>Làm</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startDateActual)" Caption="Giờ b/đ thực tế" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ b/đ</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endDateActual)" Caption="Giờ k/t thực tế" Width="90px" MinWidth="80" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ k/t</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.startBreakTimeActual)" Caption="Giờ nghỉ b/đ thực tế" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ b/đ</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.endBreakTimeActual)" Caption="Giờ nghỉ k/t thực tế" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Giờ nghỉ k/t</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ConfirmWorkingDay1Model.totalWorkingHoursActual)" Caption="Số giờ làm thực tế" Width="100px" MinWidth="90"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Số giờ làm</div>
                        <div>Thực tế</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(ShiftAssignmentModel.sGT)" Caption="Số giờ thiếu" Width="100px" MinWidth="90"
                                  TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center" DataRowEditorVisible="false">
                    <HeaderCaptionTemplate>
                        <div>Số giờ</div>
                        <div>Thiếu</div>
                    </HeaderCaptionTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    </div>
</W1Popup>

