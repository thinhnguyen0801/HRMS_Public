@page "/xin-nghi-trong-gio"
@inherits Controllers.LeaveWorkingHourController
<PageTitle>Xin nghỉ trong giờ</PageTitle>


<div class="h-content-filter">
    @if(!IsReadonlyControl)
    {
        <div class="card p-1">
            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                <Items>

                    <DxToolbarItem Text="Duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_APPROVAL}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@ApprovalHandler"
                                   Visible="@(IsAllowApproval)" />
                    <DxToolbarItem Text="Từ chối" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REJECT}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(() => RejectHandler())"
                                   Visible="@(IsAllowApproval)" />

                    <DxToolbarItem Text="Lưu" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_UPDATE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@SaveDataHandler"
                                   Visible="@((pActionType == nameof(EnumType.Add) && IsAllowPost) || (pActionType != nameof(EnumType.Add) && IsAllowPut))" />

                    <DxToolbarItem Text="Gửi phê duyệt" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_SHARE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(()=> SubmitForApprovalHandler())"
                                   Visible="@(LeaveRequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                    <DxToolbarItem Text="Hủy" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@(() => CancelDocumentHandler())"
                                   Visible="@(pActionType != nameof(EnumType.Add) && LeaveRequestDocument.statusCode == CommonConstants.STATUS_CODE_ADD && IsAllowDelete)" />

                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshDataHandler"  />
                </Items>
            </DxToolbar>
        </div>
    }
    
    <div class="card card-lg mt-1" style="padding: 5px">
        <div class="row row-gap-2">
            <div class="col-12">
                <div class="accordion" id="accordion-info">
                    <div class="accordion-item" style="border: none">
                        <span class="accordion-header" id="heading-1">
                            <button class="accordion-button " style="padding-top: 1px; padding-bottom: 1px;padding-left: 5px;"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="true">
                                <h4 class="mb-0 w1FontSize">Thông tin chung</h4>
                            </button>
                        </span>
                        <div style="border-bottom: 1px solid var(--tblr-border-color); margin-top: 2px"></div>
                        <div id="collapse-info" class="accordion-collapse collapse show" data-bs-parent="#accordion-info">
                            <div class="accordion-body p-2">
                                <div class="row row-gap-2">
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Số chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxTextBox @bind-Text="@LeaveRequestDocument.voucherNo" ReadOnly="true" CssClass="w1FontSize" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Tình trạng" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboStatus"
                                                            @bind-Value="@LeaveRequestDocument.statusCode"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex">
                                            <W1Label Value="Loại đăng ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboRequestType"
                                                            @bind-Value="@LeaveRequestDocument.requestType"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.code)"
                                                            Id="requestType" ReadOnly="@IsReadonlyControl"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày chứng từ" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@LeaveRequestDocument.createDate"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Nhân viên" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên" 
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(LeaveRequestDocument.employeeCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Phòng ban" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxComboBox Data="@ListCboDepartment"
                                                            @bind-Value="@LeaveRequestDocument.departmentId"
                                                            FilteringMode="DataGridFilteringMode.Contains"
                                                            TextFieldName="@nameof(ComboboxModel.name)"
                                                            ValueFieldName="@nameof(ComboboxModel.id)"
                                                            Id="departmentId" ReadOnly="true"
                                                            CssClass="w1FontSize">
                                                </DxComboBox>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Người ký" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-4 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeSignatureCode" ReadOnly="true" CssClass="w1FontSize" Id="employeeSignatureId" />
                                                    </div>
                                                    <div class="g-col-md-8 g-col-sm-12 g-col-12">
                                                        <DxTextBox @bind-Text="@LeaveRequestDocument.employeeSignatureName" CssClass="w1FontSize" ReadOnly="true">
                                                            <Buttons>
                                                                <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên" 
                                                                                Visible="@(!IsReadonlyControl)"
                                                                                Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(LeaveRequestDocument.employeeSignatureCode)))" />
                                                            </Buttons>
                                                        </DxTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Ngày ký" Styles="width: 120px" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxDateEdit @bind-Date="@LeaveRequestDocument.dateOfSigning"
                                                            CssClass="w1FontSize"
                                                            Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                            DisplayFormat="@GlobalContants.FORMAT_DATE" ReadOnly="true" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Từ ngày/đến ngày" Id="ngayBatDau" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <div class="grid gap-1 row-gap-2">
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit Date="@LeaveRequestDocument.fromDate"
                                                                    DateChanged="@((DateTime? fromDate)=>DateEditValueChangedHandler(fromDate, controlID: nameof(LeaveRequestDocument.fromDate)))"
                                                                    CssClass="w1FontSize" Id="startDate" ReadOnly="@IsReadonlyControl"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                    <div class="g-col-md-6 g-col-sm-12 g-col-12">
                                                        <DxDateEdit Date="@LeaveRequestDocument.toDate"
                                                                    DateChanged="@((DateTime? toDate)=>DateEditValueChangedHandler(toDate, controlID: nameof(LeaveRequestDocument.toDate)))"
                                                                    CssClass="w1FontSize" Id="endDate" ReadOnly="@IsReadonlyControl"
                                                                    Mask="@GlobalContants.FORMAT_DATE" Format="@GlobalContants.FORMAT_DATE"
                                                                    DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-12">
                                        <div class="d-flex ">
                                            <W1Label Value="Lý do nghỉ" Styles="width: 120px" IsRequired="true" />
                                            <div style="width: calc(100% - 120px)">
                                                <DxMemo @bind-Text="@LeaveRequestDocument.remark" BindValueMode="@BindValueMode.OnInput" Rows="1"
                                                        InputId="txtRemark" CssClass="w1FontSize" ReadOnly="@IsReadonlyControl" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-gap-2 mt-1 mb-3">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-0 border-bottom-0">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" Id="tabActive" CssClass="w-full w1FontSize">
                        <DxTabPage Text="Danh sách ngày nghỉ" Id="tabTTL" CssClass="w1FontSize"></DxTabPage>
                        <DxTabPage Text="Lịch sử chứng từ" Id="tabPLHD" CssClass="w1FontSize"></DxTabPage>
                    </DxTabs>
                </div>
                <div class="card-body p-1">
                    @switch (ActiveTabIndex)
                    {
                        case 0:
                            <div style="height: 350px; min-height: 350px">
                                <DxGrid Data="ListOfVacationDays" @ref="GridOfVacationDays"
                                        ShowFilterRow="false"
                                        PageSize="500"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="false"
                                        PageSizeSelectorAllRowsItemVisible="false"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        KeyFieldNames="@(new [] {nameof(LeaveRequest1Model.dateOff),nameof(LeaveRequest1Model.id)})"
                                        ValidationEnabled="true"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="@GridLeaveDateEditSavingHandler"
                                        CustomizeElement="@GridLeaveDateCustomizeElement"
                                        CustomSummary="@GridLeaveDateCustomSummary"
                                        KeyboardNavigationEnabled="true"
                                        AllowSelectRowByClick="true"
                                        FocusedRowEnabled="true"
                                        SelectionMode="GridSelectionMode.Single"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem IconCssClass="@IconClassConstants.ICON_REFRESH" BeginGroup="true" Visible="@(!IsReadonlyControl)"
                                                               Alignment="@ToolbarItemAlignment.Right" Tooltip="Lấy thông tin ngày nghỉ" Click="@CreateLeaveDateHandler" />
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.dateOff)" Caption="Ngày đăng ký" MinWidth="140" Width="140px"
                                                          DisplayFormat="@GlobalContants.FORMAT_DATE" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.fromTime)" Caption="Từ giờ" Width="130px" MinWidth="110"
                                                          DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <EditSettings>
                                                <DxTimeEditSettings CssClass="w1FontSize" Mask="@GlobalContants.FORMAT_TIME" Format="@GlobalContants.FORMAT_TIME"
                                                                    DisplayFormat="@GlobalContants.FORMAT_TIME" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.toTime)" Caption="Đến giờ" Width="130px" MinWidth="110"
                                                          DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <EditSettings>
                                                <DxTimeEditSettings CssClass="w1FontSize" Mask="@GlobalContants.FORMAT_TIME" Format="@GlobalContants.FORMAT_TIME"
                                                                    DisplayFormat="@GlobalContants.FORMAT_TIME" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.totalHours)" Caption="Số giờ nghỉ" Width="120px" MinWidth="100"
                                                          DisplayFormat="@GlobalContants.FORMAT_NUMBER" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.symbol)" Caption="Ký hiệu" Width="100px" MinWidth="90" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.remark)" Caption="Ghi chú" MinWidth="170" DataRowEditorVisible="@(!IsReadonlyControl)">
                                            <HeaderCaptionTemplate>
                                                <span>Ghi chú <span style="color: red;">&nbsp;(*)</span></span>
                                            </HeaderCaptionTemplate>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.shiftName)" Caption="Ca làm việc" Width="130px" MinWidth="100" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.startDate)" Caption="TGBD" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.endDate)" Caption="TGKT" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.startBreakTime)" Caption="TGNBD" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="false" />
                                        <DxGridDataColumn FieldName="@nameof(LeaveRequest1Model.endBreakTime)" Caption="TGNKT" Width="100px" MinWidth="90" DisplayFormat="@GlobalContants.FORMAT_TIME" DataRowEditorVisible="false" />
                                    </Columns>
                                    <TotalSummary>
                                        <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_SUM_HOUR" SummaryType="GridSummaryItemType.Custom"
                                                           FieldName="@nameof(LeaveRequest1Model.totalHours)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                           FooterColumnName="@nameof(LeaveRequest1Model.totalHours)" />
                                    </TotalSummary>
                                </DxGrid>
                            </div>
                            break;
                        case 1:
                            <div style="height: 350px; min-height: 350px; line-height: 20px" class="w1FontSize px-2 py-1 text-truncate">
                                @((MarkupString)$"{VoucherHistory}")
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="70%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    EnumType="@EnumEmployeeType"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" />
    </div>
</W1Popup>
<W1Popup @bind-IsOpenModal="@IsShowPrompt" TextBtnAccept="Xác nhận"
         HeaderText="Xác nhận" Width="55%" HandleClickAccept="@(() => CancelDocumentHandler(isAccept: true))">
    <W1Label Value="Lý do hủy" Styles="width: 120px" IsRequired />
    <div class="mt-1">
        <DxMemo @bind-Text="@ReasonDelete" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtLyDoHuy" CssClass="w1FontSize" />
    </div>
</W1Popup>
<W1Popup @bind-IsOpenModal="@IsShowPromptDeny" TextBtnAccept="Xác nhận"
         HeaderText="Xác nhận" Width="55%" HandleClickAccept="@(() => RejectHandler(isAccept: true))">
    <W1Label Value="Lý do từ chối" Styles="width: 120px" IsRequired />
    <div class="mt-1">
        <DxMemo @bind-Text="@ReasonDelete" BindValueMode="@BindValueMode.OnInput" Rows="1" InputId="txtLyDoHuy" CssClass="w1FontSize" />
    </div>
</W1Popup>
<W1Confirm @ref="confirm" />