@page "/phan-cong-ca-lam-viec"
@inherits Controllers.ShiftAssignmentController
<PageTitle>Phân công ca làm việc</PageTitle>


<div class="h-content-filter">
    <div class="grid gap-1 row-gap-2">
        <div class="@(IsShowFilter ? "g-col-md-4 g-col-sm-12 g-col-12" : "d-none")">
            <div class="card w1FontSize">
                <div class="card-header py-1 px-2">
                    <h4 class="mb-0 w1FontSize">Thông tin tìm kiếm</h4>
                </div>
                <div class="card-body p-1">
                    <div class="row row-gap-2">
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Chi nhánh" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxComboBox Data="@ListCboBranch"
                                                @bind-Value="@SearchUpdate.branchId"
                                                FilteringMode="DataGridFilteringMode.Contains"
                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                Id="txtBranchId"
                                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                    </DxComboBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Kỳ công" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxComboBox Data="@ListCboShiftPreiod"
                                                @bind-Value="@SearchUpdate.shiftPreiodId"
                                                FilteringMode="DataGridFilteringMode.Contains"
                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                ValueFieldName="@nameof(ComboboxModel.code)"
                                                Id="pShiftPreiodId"
                                                CssClass="w1FontSize">
                                    </DxComboBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Trạng thái" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxTagBox Data="@ListCboStatus"
                                              @bind-Values="@ListCboStatusSelected" CssClass="w1FontSize"
                                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                              ReadOnly="true"
                                              TextFieldName="@nameof(ComboboxModel.name)">
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                    </DxTagBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div style="height: calc(100vh - 271px); min-height: 250px">
                                <DxGrid Data="ListDepartmentSearch" @ref="GridDepartmentSearch"
                                        ShowFilterRow="true"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="true"
                                        PageSize="@GlobalContants.PageSize"
                                        PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                        PageSizeSelectorAllRowsItemVisible="true"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        FocusedRowEnabled="true"
                                        SelectionMode="@GridSelectionMode.Multiple"
                                        AutoExpandAllGroupRows="true"
                                        AllowSelectRowByClick="true"
                                        @bind-SelectedDataItems="@SelectedDataDepartments"
                                        CssClass="h-full">
                                    <Columns>
                                        <DxGridSelectionColumn Width="35px" />
                                        <DxGridDataColumn FieldName="@nameof(DepartmentModel.code)" Caption="Mã phòng ban" MinWidth="100" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.name)" Caption="Tên phòng ban" MinWidth="150" />
                                        <DxGridDataColumn FieldName="@nameof(DepartmentModel.isActive)" Caption="Hoạt động?" MinWidth="100" />
                                        <DxGridDataColumn FieldName="@nameof(DepartmentModel.headName)" Caption="Trưởng phòng" MinWidth="170" />
                                        <DxGridDataColumn FieldName="@nameof(DepartmentModel.branchName)" Caption="Chi nhánh" MinWidth="170" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
