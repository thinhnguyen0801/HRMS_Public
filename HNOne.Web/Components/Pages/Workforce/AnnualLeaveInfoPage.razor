@page "/quan-ly-phep-nam"
@inherits Controllers.AnnualLeaveInfoController
<PageTitle>Thông tin phép năm</PageTitle>

<div class="h-content-filter">
    <div class="grid gap-1 row-gap-2">
        <div class="@(IsShowFilter ? "g-col-md-4 g-col-sm-12 g-col-12" : "d-none")">
            <div class="card w1FontSize">
                <div class="card-header py-1 px-2">
                    <h4 class="mb-0 w1FontSize">Thông tin tìm kiếm</h4>
                </div>
                <div class="card-body p-1">
                    <div class="row row-gap-2">
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Chi nhánh" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxComboBox Data="@ListCboBranch"
                                                @bind-Value="@SearchUpdate.branchId"
                                                FilteringMode="DataGridFilteringMode.Contains"
                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                Id="txtBranchId"
                                                ReadOnly="true"
                                                ValueFieldName="@nameof(ComboboxModel.id)" CssClass="w1FontSize">
                                    </DxComboBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Năm công" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxComboBox Data="@ListCboYear"
                                                @bind-Value="@SearchUpdate.year"
                                                FilteringMode="DataGridFilteringMode.Contains"
                                                TextFieldName="@nameof(ComboboxModel.name)"
                                                ValueFieldName="@nameof(ComboboxModel.id)"
                                                CssClass="w1FontSize">
                                    </DxComboBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Phòng ban" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxTagBox Data="@ListCboDepartment"
                                              @bind-Values="@ListDepartmentSelected" CssClass="w1FontSize"
                                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                              TextFieldName="@nameof(ComboboxModel.name)">
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                    </DxTagBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="d-flex px-1">
                                <W1Label Value="Trạng thái" Styles="width: 90px" IsRequired="true" />
                                <div style="width: calc(100% - 90px)">
                                    <DxTagBox Data="@ListCboStatus"
                                              @bind-Values="@ListCboStatusSelected" CssClass="w1FontSize"
                                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                              TextFieldName="@nameof(ComboboxModel.name)">
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                                    </DxTagBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div style="height: calc(100vh - 305px); min-height: 250px">
                                <DxGrid Data="ListEmpSearch" @ref="GridEmpSearch"
                                        ShowFilterRow="true"
                                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                        PagerPosition="GridPagerPosition.Bottom"
                                        PageSizeSelectorVisible="true"
                                        PageSize="@GlobalContants.PageSize"
                                        PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                        PageSizeSelectorAllRowsItemVisible="true"
                                        PagerSwitchToInputBoxButtonCount="10"
                                        PagerVisibleNumericButtonCount="10"
                                        TextWrapEnabled="false"
                                        FocusedRowEnabled="true"
                                        SelectionMode="@GridSelectionMode.Multiple"
                                        SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                                        AutoExpandAllGroupRows="true"
                                        AllowSelectRowByClick="true"
                                        @bind-SelectedDataItems="@SelectedDataEmployees"
                                        CssClass="h-full">
                                    <ToolbarTemplate>
                                        <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Plain">
                                            <Items>
                                                <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right" Tooltip="Làm mới"
                                                               IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                                               Click="@ReloadEmployeeHandler" />
                                            </Items>
                                        </DxToolbar>
                                    </ToolbarTemplate>
                                    <Columns>
                                        <DxGridSelectionColumn Width="35px" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.code)" Caption="Mã nhân viên" MinWidth="100" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.name)" Caption="Họ tên" MinWidth="150" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.departmentName)" Caption="Phòng ban" MinWidth="120" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.titleName)" Caption="Chức danh" MinWidth="140" />
                                        <DxGridDataColumn FieldName="@nameof(EmployeeModel.statusName)" Caption="Trạng thái" MinWidth="150" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="@(IsShowFilter ? "g-col-md-8 g-col-sm-12 g-col-12" : "g-col-md-12 g-col-sm-12 g-col-12")">
            <div class="row row-gap-2">
                <div class="col-12">
                    <div class="card w1FontSize">
                        <div class="card-header p-1 position-relative">
                            <div class="position-absolute" style="z-index: 10">
                                <i class="@(IsShowFilter ? $"{IconClassConstants.ICON_FILTER_CLEAR}" : $"{IconClassConstants.ICON_FILTER}") @IconClassConstants.FONT_SIZE_ICON"
                                   title="@(IsShowFilter ? "Thu gọn vùng tìm kiếm" : "Mở rộng vùng tìm kiếm")" @onclick="@ShowFilterHandler" />
                            </div>
                            <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                                <Items>
                                    <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />
                                    <DxToolbarItem Text="Điều chỉnh phép" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                                   Alignment="@ToolbarItemAlignment.Right" Click="@RefreshHandler" />
                                </Items>
                            </DxToolbar>
                        </div>
                        <div class="card-body p-1" style="height: calc(100vh - 165px); min-height: 400px">
                            <DxGrid Data="ListAnnualLeaveInfo" @ref="GridAnnualLeaveInfo"
                                    ShowFilterRow="true"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                    PagerPosition="GridPagerPosition.Bottom"
                                    PageSizeSelectorVisible="true"
                                    PageSize="@GlobalContants.PageSize"
                                    PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    PagerSwitchToInputBoxButtonCount="10"
                                    PagerVisibleNumericButtonCount="10"
                                    TextWrapEnabled="false"
                                    FocusedRowEnabled="true"
                                    AutoExpandAllGroupRows="true"
                                    KeyboardNavigationEnabled="true"
                                    CssClass="h-full">
                                <Columns>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.employeeCode)" Caption="Mã nhân viên" MinWidth="120" Width="110px">
                                        <CellDisplayTemplate>
                                            @{
                                                <a @onclick="@(()=> OpenPopupDetailHandler((context.DataItem as AnnualLeaveInfoModel)))">@context.Value</a>
                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.employeeName)" Caption="Tên nhân viên" MinWidth="140" />
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.probationStartDate)" Caption="Ngày vào làm" MinWidth="100" Width="110px" DisplayFormat="@GlobalContants.FORMAT_DATE" />
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.year)" DisplayFormat="d" Caption="Năm" MinWidth="80" Width="80px" />
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeaveDefault)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép mặc định" MinWidth="90" Width="100px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép</div>
                                            <div>mặc định</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeave)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép trong năm" MinWidth="90" Width="100px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép</div>
                                            <div>trong năm</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeaveLevel)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép thâm niên" MinWidth="90" Width="100px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép</div>
                                            <div>thâm niên</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeaveUsed)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép đã sử dụng" MinWidth="110" Width="110px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép trong năm</div>
                                            <div>đã sử dụng</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfAdjustedLeave)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép đã điều chỉnh" MinWidth="110" Width="110px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép năm</div>
                                            <div>đã điều chỉnh</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeavePaid)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép đã thanh toán" MinWidth="110" Width="110px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép năm</div>
                                            <div>đã thanh toán</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeaveOld)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép năm củ" MinWidth="90" Width="100px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép</div>
                                            <div>năm củ</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.expiryDate)" Caption="Ngày hết hạn phép năm củ" DisplayFormat="@GlobalContants.FORMAT_DATE"
                                                      MinWidth="100" Width="110px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Ngày hết hạn</div>
                                            <div>phép năm củ</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeaveOldPaid)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép củ đã thanh toán" MinWidth="110" Width="110px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép năm củ</div>
                                            <div>đã thanh toán</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="@nameof(AnnualLeaveInfoModel.numOfLeaveRemaining)" DisplayFormat="@GlobalContants.FORMAT_NUMBER_DOUBLE_1PLACE"
                                                      Caption="Phép còn lại" MinWidth="90" Width="100px" TextAlignment="@GridTextAlignment.Center" CaptionAlignment="@GridTextAlignment.Center">
                                        <HeaderCaptionTemplate>
                                            <div>Phép</div>
                                            <div>còn lại</div>
                                        </HeaderCaptionTemplate>
                                    </DxGridDataColumn>

                                </Columns>
                                <TotalSummary>
                                    <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                                       FieldName="@nameof(AnnualLeaveInfoModel.employeeCode)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                                       FooterColumnName="@nameof(AnnualLeaveInfoModel.employeeCode)" />
                                </TotalSummary>
                            </DxGrid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDetail" Width="85%"
         TextBtnAccept="Chọn"
         IsShowFooter="false"
         HeaderText="@HeaderTextDetail">
    <div style="height: 400px; min-height: 350px">
        <DxGrid Data="ListAdjustedALRequest" @ref="GridAdjustedALRequest"
                ShowFilterRow="true"
                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                PagerPosition="GridPagerPosition.Bottom"
                PageSizeSelectorVisible="true"
                PageSize="@GlobalContants.PageSize"
                PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                PageSizeSelectorAllRowsItemVisible="true"
                PagerSwitchToInputBoxButtonCount="10"
                PagerVisibleNumericButtonCount="10"
                TextWrapEnabled="false"
                FocusedRowEnabled="true"
                AutoExpandAllGroupRows="true"
                KeyboardNavigationEnabled="true"
                CssClass="h-full">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(AdjustedAnnualLeaveRequestModel.voucherNo)" Caption="Mã chứng từ" MinWidth="140">
                    <CellDisplayTemplate>
                        @{
                            <a href="@($"{(context.DataItem as AdjustedAnnualLeaveRequestModel)!.link}")">@context.Value</a>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(AdjustedAnnualLeaveRequestModel.createDate)" Caption="Ngày chứng từ" DisplayFormat="@GlobalContants.FORMAT_DATE" MinWidth="120" />
                <DxGridDataColumn FieldName="@nameof(AdjustedAnnualLeaveRequestModel.statusName)" Caption="Trạng thái" MinWidth="130" />
                <DxGridDataColumn FieldName="@nameof(AdjustedAnnualLeaveRequestModel.year)" Caption="Năm điều chỉnh" MinWidth="110" DisplayFormat="d" />
                <DxGridDataColumn FieldName="@nameof(AdjustedAnnualLeaveRequestModel.remark)" Caption="Lý do" MinWidth="170" />
                <DxGridDataColumn FieldName="@nameof(AdjustedAnnualLeaveRequestModel.dateTracking)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
            </Columns>
            <TotalSummary>
                <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                   FieldName="@nameof(AdjustedAnnualLeaveRequestModel.voucherNo)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                   FooterColumnName="@nameof(AdjustedAnnualLeaveRequestModel.voucherNo)" />
            </TotalSummary>
        </DxGrid>
    </div>
</W1Popup>