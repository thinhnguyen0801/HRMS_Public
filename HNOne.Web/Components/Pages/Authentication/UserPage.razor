@page "/tai-khoan"
@inherits Controllers.UserController

<PageTitle>Tài khoản</PageTitle>

<div class="h-content-filter">
    <div class="row row-gap-2">
        <div class="col-12">
            <div class="card w1FontSize">
                <div class="card-header p-1">
                    <DxToolbar ItemRenderStyleMode="@ToolbarRenderStyleMode.Contained">
                        <Items>
                            <DxToolbarItem Text="Làm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_REFRESH}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> RefreshHandler())" />

                            <DxToolbarItem Text="Thêm mới" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_ADD}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> OnOpenDialogHandler())" Visible="@(IsAllowPost)" />

                            <DxToolbarItem Text="Xóa" BeginGroup="true" IconCssClass="@($"{IconClassConstants.ICON_DELETE}")" CssClass="w1FontSize"
                                           Alignment="@ToolbarItemAlignment.Right" Click="@(()=> DeleteDataHandler())" Visible="@(IsAllowDelete)" />
                        </Items>
                    </DxToolbar>
                </div>
                <div class="card-body p-1" style="height: calc(100vh - 155px); min-height: 350px">
                    <DxGrid Data="ListUser" @ref="GridUser"
                            ShowFilterRow="true"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            PagerPosition="GridPagerPosition.Bottom"
                            PageSizeSelectorVisible="true"
                            PageSize="@GlobalContants.PageSize"
                            PageSizeSelectorItems="@(GlobalContants.PageSizeList)"
                            PageSizeSelectorAllRowsItemVisible="true"
                            PagerSwitchToInputBoxButtonCount="10"
                            PagerVisibleNumericButtonCount="10"
                            TextWrapEnabled="false"
                            FocusedRowEnabled="true"
                            SelectionMode="@GridSelectionMode.Multiple"
                            @bind-SelectedDataItems="@SelectedUsers"
                            KeyFieldName="@nameof(UserModel.userName)"
                            CssClass="h-full">
                        <Columns>
                            <DxGridSelectionColumn Width="45px" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.userName)" Caption="Tài khoản" MinWidth="130">
                                <CellDisplayTemplate>
                                    @{
                                        if(IsAllowPut)
                                        {
                                            <a @onclick="@(() => OnOpenDialogHandler(EnumType.Update, (context.DataItem as UserModel)))">@context.Value</a>
                                        }
                                        else
                                        {
                                            <span>@context.Value</span>
                                        }
                                        
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>/>
                            <DxGridDataColumn FieldName="@nameof(UserModel.employeeCode)" Caption="Mã nhân viên" MinWidth="140" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.employeeName)" Caption="Nhân viên" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.branchName)" Caption="Chi nhánh" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.isActive)" Caption="Hoạt động?" MinWidth="100" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.isAdmin)" Caption="Quản trị viên?" MinWidth="100" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.perGroupName)" Caption="Nhóm quyền" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.branchIds)" Caption="Chi nhánh sử dụng" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.departmentIds)" Caption="Phòng ban sử dụng" MinWidth="170" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.createDate)" Caption="Ngày cập nhật" MinWidth="120" DisplayFormat="@GlobalContants.FORMAT_DATE_TIME" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.userSignName)" Caption="Người tạo" MinWidth="120" />
                            <DxGridDataColumn FieldName="@nameof(UserModel.userSign2Name)" Caption="Người cập nhật" MinWidth="120" />
                        </Columns>
                        <TotalSummary>
                            <DxGridSummaryItem DisplayText="@GlobalContants.FORMAT_GRID_DISPLAYTEXT_COUNT" SummaryType="GridSummaryItemType.Count"
                                               FieldName="@nameof(UserModel.userName)" ValueDisplayFormat="@GlobalContants.FORMAT_CURRENCY"
                                               FooterColumnName="@nameof(UserModel.userName)" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<W1Popup @bind-IsOpenModal="@IsShowDialog"
         Width="65%" TextBtnAccept="Cập nhật"
         HeaderText="Thêm mới danh mục lý do"
         HandleClickAccept="@SaveDataHandler">
    <div class="row row-gap-2">
        <div class="col-sm-12">
            <div class="d-flex ">
                <W1Label Value="Tài khoản" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <div class="row row-gap-2">
                        <div class="col-md-8 col-sm-12">
                            <DxTextBox @bind-Text="@UserUpdate.userName" CssClass="w1FontSize" Id="txtUserName" autocomplete="off"></DxTextBox>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <DxCheckBox CssClass="w-100 w1FontSize"
                                        SizeMode="@SizeMode.Small"
                                        @bind-Checked="@UserUpdate.isActive"
                                        LabelPosition="@LabelPosition.Right">
                                Hoạt động?
                            </DxCheckBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Mật khẩu" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px); position: relative;">
                    <DxTextBox @bind-Text="@UserUpdate.password" Id="txtPassword" autocomplete="off"
                               SizeMode="SizeMode.Medium" Password="@(!IsShowPassword)">
                        <Buttons>
                            <DxEditorButton IconCssClass="@(IsShowPassword ? "fa-regular fa-eye" : "fa-regular fa-eye-slash")"
                                            Tooltip="Hiển thị mật khẩu" Click="@ShowPasswordHandler" />
                        </Buttons>
                    </DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Nhập lại mật khẩu" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px); position: relative;">
                    <DxTextBox @bind-Text="@UserUpdate.rePassword" Id="txtRePassword"
                               SizeMode="SizeMode.Medium" Password="@(!IsShowRePassword)">
                        <Buttons>
                            <DxEditorButton IconCssClass="@(IsShowRePassword ? "fa-regular fa-eye" : "fa-regular fa-eye-slash")"
                                            Tooltip="Hiển thị mật khẩu" Click="@ShowRePasswordHandler" />
                        </Buttons>
                    </DxTextBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Chi nhánh" Styles="width: 120px" IsRequired="true" />
                <div style="width: calc(100% - 120px)">
                    <DxComboBox Data="@ListCboBranch"
                                @bind-Value="@UserUpdate.branchId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                ValueFieldName="@nameof(ComboboxModel.id)" 
                                CssClass="w1FontSize" Id="txtBranchId" 
                                DropDownCssClass="w1FontSize"
                                DropDownBodyCssClass="w1FontSize">
                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Width="120px" Caption="Mã" />
                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                        </Columns>
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Nhân viên" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <div class="grid gap-1 row-gap-2">
                        <div class="g-col-md-4 g-col-sm-12 g-col-12">
                            <DxTextBox @bind-Text="@UserUpdate.employeeCode" ReadOnly="true" CssClass="w1FontSize" ClearButtonDisplayMode="@DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                        <div class="g-col-md-8 g-col-sm-12 g-col-12">
                            <DxTextBox @bind-Text="@UserUpdate.employeeName" CssClass="w1FontSize" ReadOnly="true">
                                <Buttons>
                                    <DxEditorButton style="width: 29px" CssClass="w1FontSize" IconCssClass="fas fa-search" Tooltip="Tìm kiếm nhân viên"
                                                    Click="@(async () => await OpenPopupHandler(nameof(EmployeeSelected), nameof(UserUpdate.employeeCode)))" />
                                </Buttons>
                            </DxTextBox>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Nhóm quyền" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxComboBox Data="@ListCboPerGroup"
                                @bind-Value="@UserUpdate.perGroupId"
                                FilteringMode="DataGridFilteringMode.Contains"
                                TextFieldName="@nameof(ComboboxModel.name)"
                                ValueFieldName="@nameof(ComboboxModel.id)" 
                                CssClass="w1FontSize"
                                DropDownCssClass="w1FontSize"
                                DropDownBodyCssClass="w1FontSize">
                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Width="120px" Caption="Mã" />
                            <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                        </Columns>
                    </DxComboBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Chi nhánh sử dụng" Id="bacLuong" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxTagBox Data="@ListCboBranch"
                              @bind-Values="@ListCboBranchSelected" CssClass="w1FontSize"
                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                              TextFieldName="@nameof(ComboboxModel.name)">
                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                    </DxTagBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="Phòng ban sử dụng" Id="bacLuong" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxTagBox Data="@ListCboDepartment"
                              @bind-Values="@ListDepartmentSelected" CssClass="w1FontSize"
                              DropDownBodyCssClass="w1FontSize" DropDownCssClass="w1FontSize"
                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                              TextFieldName="@nameof(ComboboxModel.name)">
                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.code)" Caption="Mã" Width="120px" />
                        <DxListEditorColumn FieldName="@nameof(ComboboxModel.name)" Caption="Tên" />
                    </DxTagBox>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="d-flex">
                <W1Label Value="" Id="bacLuong" Styles="width: 120px" />
                <div style="width: calc(100% - 120px)">
                    <DxCheckBox CssClass="w-100 w1FontSize"
                                SizeMode="@SizeMode.Small"
                                @bind-Checked="@UserUpdate.isAdmin"
                                LabelPosition="@LabelPosition.Right">
                        Quản trị viên?
                    </DxCheckBox>
                </div>
            </div>
        </div>
    </div>
</W1Popup>

<W1Popup @bind-IsOpenModal="@IsShowDialogEmpSearch" Width="55%"
         HandleClickAccept="@(()=> SelectEmployeeHandler())"
         TextBtnAccept="Chọn"
         HeaderText="Danh sách nhân viên">
    <div style="height: 400px; min-height: 350px">
        <W1Employee UserId="@UserId" Token="@Token" BranchId="@BranchId" DepartmentIds="@DepartmentIds" StatusIds="@StatusIds"
                    SelectedDataItemChanged="@EventCallbackEmpChangedHandler" />
    </div>
</W1Popup>

<W1Confirm @ref="confirm" />